<Window x:Class="Guanacaste3D.Desktop.OpeningTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource OpeningTypes.WindowTitle}" Width="900" Height="760" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Parameters.Close}" Click="Close_Click" MinWidth="90" IsCancel="True"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource OpeningTypes.Header}" Style="{StaticResource PanelHeaderStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <ComboBox x:Name="KindFilterBox" Width="130" Margin="0,0,10,0" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectionChanged="KindFilterBox_SelectionChanged"/>
              <Button x:Name="UndoButton" Content="{DynamicResource Action.Undo}" Click="Undo_Click" MinWidth="80" Margin="0,0,4,0"/>
              <Button x:Name="RedoButton" Content="{DynamicResource Action.Redo}" Click="Redo_Click" MinWidth="80"/>
            </StackPanel>
          </DockPanel>
          <Button DockPanel.Dock="Bottom" Content="{DynamicResource OpeningTypes.Purge}" Click="Purge_Click"
                  HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3"/>
          <ListBox x:Name="TypesList" SelectionChanged="TypesList_SelectionChanged" BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <StackPanel>
          <TextBlock Text="{DynamicResource OpeningTypes.EditorHeader}" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8"/>
          <TextBlock Text="{DynamicResource OpeningTypes.Kind}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
          <ComboBox x:Name="KindBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="KindBox_SelectionChanged"/>
          <TextBlock Text="{DynamicResource OpeningTypes.Family}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
          <TextBox x:Name="FamilyBox" MaxLength="120"/>
          <TextBlock Text="{DynamicResource Parameters.Name}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
          <TextBox x:Name="NameBox" MaxLength="120"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource OpeningTypes.Width}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
              <TextBox x:Name="WidthBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource OpeningTypes.Height}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
              <TextBox x:Name="HeightBox"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="{DynamicResource OpeningTypes.DefaultSill}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
              <TextBox x:Name="SillBox"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{DynamicResource OpeningTypes.Material}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
          <TextBox x:Name="MaterialBox" MaxLength="120"/>
          <TextBlock x:Name="UsageText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <UniformGrid Columns="2" Margin="0,10,0,0">
            <Button Content="{DynamicResource Parameters.New}" Click="New_Click" Margin="0,0,4,4"/>
            <Button Content="{DynamicResource Parameters.Apply}" Click="Apply_Click" Margin="4,0,0,4"/>
            <Button Content="{DynamicResource OpeningTypes.Duplicate}" Click="Duplicate_Click" Margin="0,0,4,0"/>
            <Button Content="{DynamicResource Parameters.Delete}" Click="Delete_Click" Margin="4,0,0,0"/>
          </UniformGrid>
          <Button x:Name="ImportButton" Content="{DynamicResource OpeningTypes.Import}" Click="Import_Click" Margin="0,6,0,0"/>
          <ProgressBar x:Name="ImportProgress" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
          <TextBlock Text="{DynamicResource OpeningTypes.ImportHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
