<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Guanacaste3D.Desktop</AssemblyName>
    <RootNamespace>Guanacaste3D.Desktop</RootNamespace>
    <Product>Guanacaste 3D</Product>
    <Version>0.23.0</Version>
    <!-- Embedded in the .exe so Explorer, the Start menu shortcut and the taskbar show the brand mark. -->
    <ApplicationIcon>resources\brand\guanacaste3d.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Guanacaste3D.Core/Guanacaste3D.Core.csproj" />
    <ProjectReference Include="../Guanacaste3D.Agent/Guanacaste3D.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Per-frame picture buffers (a few MB) are short-lived; keeping them out of the large-object heap lets cheap
         collections reclaim them, so a long live preview does not grow the process by gigabytes. -->
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="8388608" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window.Icon reads the same icon through a pack URI at run time. -->
    <Resource Include="resources\brand\guanacaste3d.ico" />
    <!-- Shipped render textures, loaded from disk next to the executable by RenderTextureLibrary. -->
    <Content Include="resources\textures\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="resources\textures\*.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Detailed mesh families (CC0 trees and cars, see docs/third-party-models.md) and the saved sample projects. -->
    <Content Include="resources\families\*.g3df" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="resources\samples\*.g3d" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Rendered pictures of the samples for the Home screen tiles. -->
    <Content Include="resources\samples\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The Revit bridge add-in reads .rvt projects through the user's Revit. It compiles against Revit's own API, so it is
    built for each Revit version installed on the build machine and shipped in revit-bridge\Revit<year>\.
    Copies continue on error because a running Revit keeps the previous add-in loaded.
  -->
  <ItemGroup>
    <RevitBridgeVersion Include="2025;2026;2027" />
  </ItemGroup>
  <Target Name="BuildRevitBridge" AfterTargets="Build">
    <MSBuild Projects="..\Guanacaste3D.RevitBridge\Guanacaste3D.RevitBridge.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);RevitVersion=%(RevitBridgeVersion.Identity);RestoreStage=1"
             Condition="Exists('$(ProgramW6432)\Autodesk\Revit %(RevitBridgeVersion.Identity)\RevitAPI.dll')" />
    <MSBuild Projects="..\Guanacaste3D.RevitBridge\Guanacaste3D.RevitBridge.csproj"
             Properties="Configuration=$(Configuration);RevitVersion=%(RevitBridgeVersion.Identity)"
             Condition="Exists('$(ProgramW6432)\Autodesk\Revit %(RevitBridgeVersion.Identity)\RevitAPI.dll')" />
    <Copy SourceFiles="..\Guanacaste3D.RevitBridge\bin\$(Configuration)\Revit%(RevitBridgeVersion.Identity)\Guanacaste3D.RevitBridge.dll"
          DestinationFolder="$(OutDir)revit-bridge\Revit%(RevitBridgeVersion.Identity)" SkipUnchangedFiles="true" ContinueOnError="true"
          Condition="Exists('..\Guanacaste3D.RevitBridge\bin\$(Configuration)\Revit%(RevitBridgeVersion.Identity)\Guanacaste3D.RevitBridge.dll')" />
  </Target>
  <Target Name="PublishRevitBridge" AfterTargets="Publish">
    <Copy SourceFiles="..\Guanacaste3D.RevitBridge\bin\$(Configuration)\Revit%(RevitBridgeVersion.Identity)\Guanacaste3D.RevitBridge.dll"
          DestinationFolder="$(PublishDir)revit-bridge\Revit%(RevitBridgeVersion.Identity)" SkipUnchangedFiles="true"
          Condition="Exists('..\Guanacaste3D.RevitBridge\bin\$(Configuration)\Revit%(RevitBridgeVersion.Identity)\Guanacaste3D.RevitBridge.dll')" />
  </Target>
</Project>
