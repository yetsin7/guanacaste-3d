<Window x:Class="Guanacaste3D.Desktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Guanacaste3D.Desktop.Controls"
  Title="{DynamicResource App.Name}" Width="1680" Height="960"
  MinWidth="1180" MinHeight="760" FontFamily="Segoe UI Variable Display, Segoe UI"
  Background="{DynamicResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen"
  WindowState="Maximized">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Height="48"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="31" Height="31" Margin="0,0,10,0">
            <TextBlock Text="G3" Foreground="White" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button Content="↶" Click="Undo_Click" Style="{StaticResource QuickAccessButtonStyle}"
                  ToolTip="{DynamicResource Action.Undo}"/>
          <Button Content="↷" Click="Redo_Click" Style="{StaticResource QuickAccessButtonStyle}"
                  ToolTip="{DynamicResource Action.Redo}"/>
          <Button Content="▣" Click="Save_Click" Style="{StaticResource QuickAccessButtonStyle}"
                  ToolTip="{DynamicResource Action.Save}"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource App.Name}" Foreground="{DynamicResource PrimaryTextBrush}"
                   FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{DynamicResource App.Tagline}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Menu DockPanel.Dock="Top" Background="#FBFBFD" Padding="9,1" Foreground="{DynamicResource PrimaryTextBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <MenuItem Header="{DynamicResource Menu.File}">
        <MenuItem Header="{DynamicResource Action.NewProject}" Click="New_Click"/>
        <MenuItem Header="{DynamicResource Action.OpenProject}" Click="Open_Click"/>
        <MenuItem Header="{DynamicResource Action.OpenSample}" Click="OpenSample_Click"/>
        <Separator/>
        <MenuItem Header="{DynamicResource Action.Save}" Click="Save_Click"/>
        <MenuItem Header="{DynamicResource Action.SaveAs}" Click="SaveAs_Click"/>
        <MenuItem Header="{DynamicResource Action.ExportQuantities}" Click="ExportQuantities_Click"/>
        <MenuItem Header="{DynamicResource Action.ExportDxf}" Click="ExportDxf_Click"/>
        <MenuItem Header="{DynamicResource Action.ExportIfc}" Click="ExportIfc_Click"/>
        <MenuItem Header="{DynamicResource Action.ExportModel3D}" Click="ExportModel3D_Click"/>
        <Separator/>
        <MenuItem Header="{DynamicResource Action.Exit}" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Edit}">
        <MenuItem Header="{DynamicResource Action.Undo}" Click="Undo_Click"/>
        <MenuItem Header="{DynamicResource Action.Redo}" Click="Redo_Click"/>
        <MenuItem Header="{DynamicResource Action.Delete}" Click="Delete_Click"/>
        <MenuItem Header="{DynamicResource Action.Duplicate}" Click="Duplicate_Click"/>
        <MenuItem Header="{DynamicResource Action.Move}" Click="Move_Click"/>
        <MenuItem Header="{DynamicResource Action.Rotate}" Click="Rotate_Click"/>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.View}">
        <MenuItem Header="{DynamicResource Tool.Plan}" Click="ShowPlan_Click"/>
        <MenuItem Header="{DynamicResource Tool.Model3D}" Click="ShowModel_Click"/>
        <MenuItem Header="{DynamicResource Tool.Elevation}" Click="ShowElevation_Click"/>
        <MenuItem Header="{DynamicResource Tool.Section}" Click="ShowSection_Click"/>
        <MenuItem Header="{DynamicResource Tool.Schedule}" Click="ShowSchedule_Click"/>
        <MenuItem Header="{DynamicResource Tool.Sheets}" Click="ShowSheet_Click"/>
        <MenuItem Header="{DynamicResource Tool.Render}" Click="ShowRender_Click"/>
        <Separator/>
        <MenuItem Header="{DynamicResource Action.Fit}" Click="FitPlan_Click"/>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Help}">
        <MenuItem Header="{DynamicResource Action.About}" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <TabControl x:Name="RibbonTabControl" DockPanel.Dock="Top" Height="166"
                Background="{DynamicResource RibbonBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" ItemContainerStyle="{StaticResource RibbonTabItemStyle}">
      <TabItem Header="{DynamicResource Ribbon.Architecture}">
        <controls:ArchitectureRibbon x:Name="ArchitectureRibbonControl"
          CommandInvoked="ArchitectureRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Structure}">
        <controls:ProfessionalRibbon Workspace="Structure" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Concrete}">
        <controls:ProfessionalRibbon Workspace="Concrete" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Steel}">
        <controls:ProfessionalRibbon Workspace="Steel" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Systems}">
        <controls:ProfessionalRibbon Workspace="Systems" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Insert}">
        <controls:ProfessionalRibbon Workspace="Insert" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Annotate}">
        <controls:ProfessionalRibbon Workspace="Annotate" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Analyze}">
        <controls:ProfessionalRibbon Workspace="Analyze" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.MassAndSite}">
        <controls:ProfessionalRibbon Workspace="MassAndSite" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Collaborate}">
        <controls:ProfessionalRibbon Workspace="Collaborate" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.View}">
        <controls:ProfessionalRibbon Workspace="View" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Manage}">
        <controls:ProfessionalRibbon Workspace="Manage" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.AddIns}">
        <controls:ProfessionalRibbon Workspace="AddIns" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
      <TabItem Header="{DynamicResource Ribbon.Modify}">
        <controls:ProfessionalRibbon Workspace="Modify" CommandInvoked="ProfessionalRibbon_CommandInvoked"/>
      </TabItem>
    </TabControl>

    <StatusBar DockPanel.Dock="Bottom" Background="#FBFBFD" BorderBrush="{DynamicResource PanelBorderBrush}"
               BorderThickness="0,1,0,0" Padding="8,2">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="{DynamicResource Status.Ready}" Foreground="{DynamicResource SecondaryTextBrush}"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="ActiveViewText" Text="{DynamicResource View.Plan}"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="ScaleText" Text="{DynamicResource Status.Scale}"/></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="326" MinWidth="286" MaxWidth="420"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="{DynamicResource PanelBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="270"/>
          <RowDefinition Height="5"/>
          <RowDefinition Height="2*" MinHeight="210"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,16">
              <Border Background="#ECEDEF" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{DynamicResource Properties.Title}" Style="{StaticResource PanelHeaderStyle}"/>
              </Border>
              <Border Margin="12,10,12,7" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                      Background="White" Padding="9">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="45" Height="45" Background="#F1F7FA" Margin="0,0,9,0">
                    <Viewbox Margin="8"><Image Source="{StaticResource Icon.Plan}"/></Viewbox>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Properties.ActiveView}" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="PropertiesActiveViewText" Text="{DynamicResource View.Plan}"
                               FontSize="13" FontWeight="SemiBold"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Grid Margin="12,2,12,6">
                <TextBlock Text="{Binding Text, ElementName=PropertiesActiveViewText}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Properties.EditType}" HorizontalAlignment="Right"
                        Padding="8,2" MinHeight="25" Click="ArchitecturePropertiesEditType_Click"/>
              </Grid>
              <TextBlock x:Name="PropertiesText" Margin="12,0" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"
                         FontSize="12" LineHeight="20"/>
              <Separator Margin="12,14,12,11"/>
              <TextBlock Text="{DynamicResource Properties.Instance}" Style="{StaticResource PropertySectionHeaderStyle}"/>
              <TextBlock Text="{DynamicResource Properties.Thickness}" Style="{StaticResource PropertyLabelStyle}"/>
              <TextBox x:Name="ThicknessInput" Text="0.20" Margin="12,0"/>
              <TextBlock Text="{DynamicResource Properties.Height}" Style="{StaticResource PropertyLabelStyle}"/>
              <TextBox x:Name="HeightInput" Text="3.00" Margin="12,0"/>
              <Button Content="{DynamicResource Properties.ApplyWall}" Click="ApplyProperties_Click"
                      Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Stretch" Margin="12,8,12,0"/>
              <Separator Margin="12,14,12,11"/>
              <TextBlock Text="{DynamicResource Properties.Transform}" Style="{StaticResource PropertySectionHeaderStyle}"/>
              <TextBlock Text="{DynamicResource Properties.MoveXY}" Style="{StaticResource PropertyLabelStyle}"/>
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="MoveXInput" Text="1.00" Margin="0,0,4,0"/>
                <TextBox x:Name="MoveYInput" Grid.Column="1" Text="0.00" Margin="4,0,0,0"/>
              </Grid>
              <Button Content="{DynamicResource Properties.MoveCoordinates}" Click="MovePrecise_Click" Margin="12,7,12,9"/>
              <TextBlock Text="{DynamicResource Properties.Rotation}" Style="{StaticResource PropertyLabelStyle}"/>
              <TextBox x:Name="RotationInput" Text="90" Margin="12,0"/>
              <Button Content="{DynamicResource Properties.ApplyRotation}" Click="RotatePrecise_Click" Margin="12,7,12,0"/>
              <Separator Margin="12,14,12,11"/>
              <TextBlock Text="{DynamicResource Properties.Opening}" Style="{StaticResource PropertySectionHeaderStyle}"/>
              <TextBlock Text="{DynamicResource Properties.OpeningCenterWidth}" Style="{StaticResource PropertyLabelStyle}"/>
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="OpeningOffsetInput" Margin="0,0,4,0"/>
                <TextBox x:Name="OpeningWidthInput" Grid.Column="1" Margin="4,0,0,0"/>
              </Grid>
              <TextBlock Text="{DynamicResource Properties.OpeningSillHeight}" Style="{StaticResource PropertyLabelStyle}"/>
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="OpeningSillInput" Margin="0,0,4,0"/>
                <TextBox x:Name="OpeningHeightInput" Grid.Column="1" Margin="4,0,0,0"/>
              </Grid>
              <Button Content="{DynamicResource Properties.ApplyOpening}" Click="ApplyOpening_Click" Margin="12,7,12,0"/>
              <Button Content="{DynamicResource Properties.RemoveOpening}" Click="RemoveOpening_Click" Margin="12,5,12,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#E5E5EA"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#ECEDEF" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="{DynamicResource Browser.Title}" Style="{StaticResource PanelHeaderStyle}"/>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="9,5,9,3">
              <Button ToolTip="{DynamicResource Browser.Home}" AutomationProperties.Name="{DynamicResource Browser.Home}" Click="ShowPlan_Click" Style="{StaticResource BrowserToolbarButtonStyle}"><Image Source="{StaticResource Icon.Plan}"/></Button>
              <Button ToolTip="{DynamicResource Browser.Model}" AutomationProperties.Name="{DynamicResource Browser.Model}" Click="ShowModel_Click" Style="{StaticResource BrowserToolbarButtonStyle}"><Image Source="{StaticResource Icon.Cube}"/></Button>
              <Button ToolTip="{DynamicResource Browser.Schedules}" AutomationProperties.Name="{DynamicResource Browser.Schedules}" Click="ShowSchedule_Click" Style="{StaticResource BrowserToolbarButtonStyle}"><Image Source="{StaticResource Icon.Schedule}"/></Button>
              <Button ToolTip="{DynamicResource Browser.Sheets}" AutomationProperties.Name="{DynamicResource Browser.Sheets}" Click="ShowSheet_Click" Style="{StaticResource BrowserToolbarButtonStyle}"><Image Source="{StaticResource Icon.Sheets}"/></Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
              <TextBlock Text="{DynamicResource Browser.Search}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox x:Name="ProjectSearchInput" Margin="0,4,0,0" TextChanged="ProjectSearchInput_TextChanged"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="9,6,9,10">
              <Button Content="{DynamicResource Browser.AddLevel}" Click="AddLevel_Click" HorizontalAlignment="Stretch"/>
              <Button Content="{DynamicResource Browser.AddSheet}" Click="AddSheet_Click" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <TreeView x:Name="ProjectTree" Margin="9,2,5,4" BorderThickness="0"
                      SelectedItemChanged="ProjectTree_SelectedItemChanged"/>
          </DockPanel>
        </Border>
      </Grid>

      <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
        <DockPanel>
          <Border x:Name="WallOptionsBar" DockPanel.Dock="Top" Visibility="Collapsed"
                  Background="{DynamicResource ContextualBarBrush}" BorderBrush="#B8D7FF"
                  BorderThickness="0,0,0,1" Padding="12,7">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource WallOptions.Title}" FontWeight="SemiBold"
                           Foreground="#005BBB" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="{DynamicResource WallOptions.DrawMode}" Style="{StaticResource OptionLabelStyle}"/>
                <RadioButton x:Name="WallLineMode" Content="{DynamicResource WallOptions.Line}" GroupName="WallDrawMode"
                             IsChecked="True" VerticalAlignment="Center" Margin="3,0,8,0"
                             Checked="WallOptions_Changed"/>
                <RadioButton x:Name="WallRectangleMode" Content="{DynamicResource WallOptions.Rectangle}" GroupName="WallDrawMode"
                             VerticalAlignment="Center" Margin="3,0,14,0" Checked="WallOptions_Changed"/>
                <TextBlock Text="{DynamicResource WallOptions.Height}" Style="{StaticResource OptionLabelStyle}"/>
                <TextBox x:Name="WallHeightInput" Text="3.00" Width="54" VerticalAlignment="Center" Margin="4,0,12,0"
                         TextChanged="WallOptions_Changed"/>
                <TextBlock Text="{DynamicResource WallOptions.Length}" Style="{StaticResource OptionLabelStyle}"/>
                <TextBox x:Name="WallLengthInput" Width="58" VerticalAlignment="Center" Margin="4,0,3,0"
                         KeyDown="WallLengthInput_KeyDown"/>
                <Button Content="{DynamicResource WallOptions.PlaceLength}" Click="PlaceWallByLength_Click"
                        Style="{StaticResource ContextualButtonStyle}" Margin="0,0,12,0"/>
                <TextBlock Text="{DynamicResource WallOptions.LocationLine}" Style="{StaticResource OptionLabelStyle}"/>
                <ComboBox x:Name="WallLocationLinePicker" Width="142" SelectedIndex="0" VerticalAlignment="Center"
                          SelectionChanged="WallOptions_Changed">
                  <ComboBoxItem Content="{DynamicResource WallOptions.Centerline}" Tag="Center"/>
                  <ComboBoxItem Content="{DynamicResource WallOptions.ExteriorFace}" Tag="Exterior"/>
                  <ComboBoxItem Content="{DynamicResource WallOptions.InteriorFace}" Tag="Interior"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource WallOptions.Offset}" Style="{StaticResource OptionLabelStyle}" Margin="12,0,0,0"/>
                <TextBox x:Name="WallOffsetInput" Text="0.00" Width="54" VerticalAlignment="Center" Margin="4,0,12,0"
                         TextChanged="WallOptions_Changed"/>
                <CheckBox x:Name="WallChainCheck" Content="{DynamicResource WallOptions.Chain}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="WallOrthogonalCheck" Content="{DynamicResource WallOptions.Orthogonal}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,12,0" Checked="WallOptions_Changed" Unchecked="WallOptions_Changed"/>
                <CheckBox x:Name="WallObjectSnapCheck" Content="{DynamicResource WallOptions.ObjectSnap}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,12,0" Checked="WallOptions_Changed" Unchecked="WallOptions_Changed"/>
                <Button Content="{DynamicResource WallOptions.Finish}" Click="FinishWallTool_Click"
                        Style="{StaticResource ContextualButtonStyle}"/>
                <Button Content="{DynamicResource WallOptions.Cancel}" Click="CancelWallTool_Click"
                        Style="{StaticResource ContextualButtonStyle}"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border DockPanel.Dock="Top" Background="#FBFBFD" BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource Workspace.ActiveLevel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="LevelPicker" Width="175" SelectionChanged="LevelPicker_SelectionChanged"/>
              <CheckBox x:Name="SnapGridCheck" Content="{DynamicResource Workspace.Snap}" IsChecked="True"
                        Margin="14,0,6,0" VerticalAlignment="Center"/>
              <CheckBox x:Name="ShowGridCheck" Content="{DynamicResource Workspace.Grid}" IsChecked="True"
                        Margin="6,0" VerticalAlignment="Center" Checked="GridVisibility_Changed" Unchecked="GridVisibility_Changed"/>
              <TextBlock Text="{DynamicResource Workspace.Shortcuts}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                         VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
          </Border>
          <TabControl x:Name="ViewTabs" Background="{DynamicResource CanvasBrush}"
                      BorderThickness="0" ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}"
                      SelectionChanged="ViewTabs_SelectionChanged">
            <TabItem Header="{DynamicResource View.Plan}">
              <Canvas x:Name="PlanCanvas" Background="White" ClipToBounds="True"
                      MouseLeftButtonDown="PlanCanvas_MouseLeftButtonDown"
                      MouseRightButtonDown="PlanCanvas_MouseRightButtonDown"
                      MouseMove="PlanCanvas_MouseMove"
                      MouseWheel="PlanCanvas_MouseWheel" SizeChanged="PlanCanvas_SizeChanged"/>
            </TabItem>
            <TabItem Header="{DynamicResource View.Model3D}">
              <Grid>
                <Border Background="#E5E5EA" MouseLeftButtonDown="ModelView_MouseLeftButtonDown"
                        MouseMove="ModelView_MouseMove" MouseLeftButtonUp="ModelView_MouseLeftButtonUp"
                        MouseWheel="ModelView_MouseWheel">
                  <Viewport3D x:Name="ModelViewport" ClipToBounds="True" SizeChanged="ModelViewport_SizeChanged"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                  <TextBlock Text="{DynamicResource Model.OrbitHint}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button Content="{DynamicResource Model.ResetCamera}" Click="ResetOrbit_Click" Padding="8,3"/>
                  <Button Content="{DynamicResource Render.Start}" Click="StartRender_Click" Padding="8,3" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource View.Schedule}">
              <DataGrid x:Name="ScheduleGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="16" Background="White">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Schedule.Category}" Binding="{Binding Category}" Width="*"/>
                  <DataGridTextColumn Header="{DynamicResource Schedule.Number}" Binding="{Binding Number}" Width="*"/>
                  <DataGridTextColumn Header="{DynamicResource Schedule.Name}" Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Header="{DynamicResource Schedule.Level}" Binding="{Binding Level}" Width="*"/>
                  <DataGridTextColumn Header="{DynamicResource Schedule.Quantity}" Binding="{Binding Quantity, StringFormat=0.##}" Width="*"/>
                  <DataGridTextColumn Header="{DynamicResource Schedule.Unit}" Binding="{Binding Unit}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource View.Sheet}">
              <Grid Background="#E5E5EA">
                <Viewbox Stretch="Uniform" Margin="28">
                  <Canvas x:Name="SheetCanvas" Width="1120" Height="792" Background="White"/>
                </Viewbox>
              </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource View.Elevation}">
              <Canvas x:Name="ElevationCanvas" Background="White" ClipToBounds="True"
                      SizeChanged="OrthographicCanvas_SizeChanged"/>
            </TabItem>
            <TabItem Header="{DynamicResource View.Section}">
              <Canvas x:Name="SectionCanvas" Background="White" ClipToBounds="True"
                      SizeChanged="OrthographicCanvas_SizeChanged"/>
            </TabItem>
            <TabItem Header="{DynamicResource View.Render}">
              <DockPanel Background="#1D1D1F">
                <Border DockPanel.Dock="Top" Background="#2C2C2E" Padding="12,7">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartRenderButton" Content="{DynamicResource Render.Start}" Click="StartRender_Click"
                            Padding="12,3" MinWidth="120"/>
                    <TextBlock Text="{DynamicResource Render.Quality}" Foreground="#DDE4E8" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox x:Name="RenderQualityPicker" Width="120" SelectedIndex="1">
                      <ComboBoxItem Content="{DynamicResource Render.Draft}"/>
                      <ComboBoxItem Content="{DynamicResource Render.Medium}"/>
                      <ComboBoxItem Content="{DynamicResource Render.High}"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource Render.Date}" Foreground="#DDE4E8" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <DatePicker x:Name="SunDatePicker" Width="112" VerticalAlignment="Center" SelectedDateFormat="Short"/>
                    <TextBlock Text="{DynamicResource Render.Latitude}" Foreground="#DDE4E8" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="SiteLatitudeInput" Text="12.1" Width="44" VerticalAlignment="Center"
                             ToolTip="{DynamicResource Render.LatitudeHint}"/>
                    <TextBlock Text="{DynamicResource Render.SunHour}" Foreground="#DDE4E8" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <Slider x:Name="SunHourSlider" Minimum="5" Maximum="19" Value="10" Width="120"
                            VerticalAlignment="Center" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding Value, ElementName=SunHourSlider, StringFormat={}{0:0.0} h}" Foreground="#DDE4E8"
                               VerticalAlignment="Center" Margin="6,0,0,0" Width="40"/>
                    <CheckBox x:Name="DenoiseCheck" Content="{DynamicResource Render.Denoise}" IsChecked="True" Foreground="#DDE4E8"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Content="{DynamicResource Render.SavePng}" Click="SaveRender_Click" Padding="10,3" Margin="10,0,0,0"/>
                    <TextBlock x:Name="RenderStatusText" Text="{DynamicResource Render.Idle}" Foreground="#AEBBC3"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                  </StackPanel>
                </Border>
                <Grid x:Name="RenderHost">
                  <Image x:Name="RenderImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>

    </Grid>
  </DockPanel>
</Window>
