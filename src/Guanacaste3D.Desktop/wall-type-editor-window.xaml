<Window x:Class="Guanacaste3D.Desktop.WallTypeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WallTypeEditor.Title}" Width="560" Height="570"
        MinWidth="500" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource WallTypeEditor.Type}" FontWeight="SemiBold"/>
      <ComboBox x:Name="TypePicker" Margin="0,5,0,14" SelectionChanged="TypePicker_SelectionChanged"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource WallTypeEditor.Identity}" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBlock Text="{DynamicResource WallTypeEditor.Name}"/>
        <TextBox x:Name="NameInput" Margin="0,4,0,9"/>
        <TextBlock Text="{DynamicResource WallTypeEditor.Function}"/>
        <ComboBox x:Name="FunctionPicker" Margin="0,4,0,9"/>
        <TextBlock Text="{DynamicResource WallTypeEditor.Thickness}"/>
        <TextBox x:Name="ThicknessInput" Margin="0,4,0,9"/>
        <TextBlock Text="{DynamicResource WallTypeEditor.Material}"/>
        <TextBox x:Name="MaterialInput" Margin="0,4,0,16"/>

        <Separator Margin="0,0,0,14"/>
        <TextBlock Text="{DynamicResource WallTypeEditor.PlanAppearance}" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{DynamicResource WallTypeEditor.FillColor}"/>
            <TextBox x:Name="PlanColorInput" Margin="0,4,0,10"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource WallTypeEditor.FillPattern}"/>
            <ComboBox x:Name="PlanPatternPicker" Margin="0,4,0,10"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="{DynamicResource WallTypeEditor.SectionAppearance}" FontWeight="SemiBold" Margin="0,7,0,7"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{DynamicResource WallTypeEditor.FillColor}"/>
            <TextBox x:Name="SectionColorInput" Margin="0,4,0,10"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource WallTypeEditor.FillPattern}"/>
            <ComboBox x:Name="SectionPatternPicker" Margin="0,4,0,10"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource WallTypeEditor.ColorHint}" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="ValidationText" Foreground="#B42318" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{DynamicResource WallTypeEditor.Cancel}" IsCancel="True" MinWidth="90"/>
      <Button Content="{DynamicResource WallTypeEditor.Save}" Click="Save_Click" MinWidth="110" Margin="8,0,0,0"
              Background="{DynamicResource AccentSoftBrush}"/>
    </StackPanel>
  </Grid>
</Window>
