<Window x:Class="Guanacaste3D.Desktop.SchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Schedules.WindowTitle}" Width="1280" Height="760" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Parameters.Close}" Click="Close_Click" MinWidth="90" IsCancel="True"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Schedules.ListHeader}" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource Schedules.NewCategory}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
            <ComboBox x:Name="NewCategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
            <UniformGrid Columns="3" Margin="0,6,0,0">
              <Button Content="{DynamicResource Parameters.New}" Click="NewSchedule_Click" Margin="0,0,3,0"/>
              <Button Content="{DynamicResource OpeningTypes.Duplicate}" Click="DuplicateSchedule_Click" Margin="2,0"/>
              <Button Content="{DynamicResource Parameters.Delete}" Click="DeleteSchedule_Click" Margin="3,0,0,0"/>
            </UniformGrid>
          </StackPanel>
          <ListBox x:Name="SchedulesList" SelectionChanged="SchedulesList_SelectionChanged" BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DesignerPanel">
            <TextBlock Text="{DynamicResource Schedules.DesignerHeader}" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Parameters.Name}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox" MaxLength="120"/>
            <TextBlock Text="{DynamicResource Schedules.Fields}" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <Grid Height="170">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ListBox x:Name="AvailableFieldsList" DisplayMemberPath="Label" SelectedValuePath="Value" MouseDoubleClick="AddField_Click"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <Button Content="→" Click="AddField_Click" Margin="0,0,0,4" ToolTip="{DynamicResource Schedules.AddField}"/>
                <Button Content="←" Click="RemoveField_Click" Margin="0,0,0,4" ToolTip="{DynamicResource Schedules.RemoveField}"/>
                <Button Content="↑" Click="MoveFieldUp_Click" Margin="0,0,0,4" ToolTip="{DynamicResource Schedules.MoveUp}"/>
                <Button Content="↓" Click="MoveFieldDown_Click" ToolTip="{DynamicResource Schedules.MoveDown}"/>
              </StackPanel>
              <ListBox x:Name="SelectedFieldsList" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Value" MouseDoubleClick="RemoveField_Click"/>
            </Grid>
            <TextBlock Text="{DynamicResource Schedules.Filters}" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <StackPanel x:Name="FilterRows"/>
            <TextBlock Text="{DynamicResource Schedules.SortGroup}" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <StackPanel x:Name="SortRows"/>
            <CheckBox x:Name="ItemizeBox" Content="{DynamicResource Schedules.Itemize}" Margin="0,10,0,0"/>
            <CheckBox x:Name="GrandTotalsBox" Content="{DynamicResource Schedules.GrandTotals}" Margin="0,4,0,0"/>
            <UniformGrid Columns="2" Margin="0,10,0,0">
              <Button Content="{DynamicResource Parameters.Apply}" Click="Apply_Click" Margin="0,0,4,0"/>
              <Button Content="{DynamicResource Parameters.ExportCsv}" Click="ExportCsv_Click" Margin="4,0,0,0"/>
            </UniformGrid>
            <Button Content="{DynamicResource Schedules.ExportRoofQuantities}" Click="ExportRoofQuantities_Click"
                    Margin="0,6,0,0" ToolTip="{DynamicResource Schedules.ExportRoofQuantitiesHint}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="PreviewTitle" Text="{DynamicResource Schedules.PreviewHeader}" Style="{StaticResource PanelHeaderStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="UndoButton" Content="{DynamicResource Action.Undo}" Click="Undo_Click" MinWidth="80" Margin="0,0,4,0"/>
              <Button x:Name="RedoButton" Content="{DynamicResource Action.Redo}" Click="Redo_Click" MinWidth="80"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="22"
                    LoadingRow="PreviewGrid_LoadingRow" BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
