<Window x:Class="Guanacaste3D.Desktop.AiRenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Render con IA — Guanacaste 3D" Width="940" Height="760"
        MinWidth="790" MinHeight="610" WindowStartupLocation="CenterOwner"
        Background="#101925" Foreground="#EAF0F6" FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EAF0F6"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Background" Value="#273D50"/>
      <Setter Property="Foreground" Value="#F3F7FA"/>
      <Setter Property="BorderBrush" Value="#425D71"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#34596B"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,9,0,0"/>
      <Setter Property="Foreground" Value="#E1EDF5"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#192B3B"/>
      <Setter Property="Foreground" Value="#EAF0F6"/>
      <Setter Property="BorderBrush" Value="#3E556A"/>
      <Setter Property="Padding" Value="9,7"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#263B50"/>
      <Setter Property="Foreground" Value="#182A38"/>
      <Setter Property="BorderBrush" Value="#60758A"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="MinHeight" Value="35"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22,18,22,17">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="RENDER CON INTELIGENCIA ARTIFICIAL" FontSize="11" Foreground="#75E3CF" FontWeight="Bold"/>
      <TextBlock Text="Prepara tu imagen y tu prompt para cualquier IA" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,5"/>
      <TextBlock Text="Sin API ni suscripción en Guanacaste 3D. Copia la imagen y el texto y pégalos en la IA que prefieras."
                 Foreground="#A9BED0" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,19,0,15">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="335"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#182738" BorderBrush="#33485A" BorderThickness="1" CornerRadius="10" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="ESTILO DE RENDER" FontSize="12" FontWeight="Bold" Foreground="#75E3CF" Margin="0,0,0,8"/>
            <ComboBox x:Name="StylePicker" DisplayMemberPath="Name"/>
            <TextBlock Text="MEJORAS Y ELEMENTOS" FontSize="12" FontWeight="Bold" Foreground="#75E3CF" Margin="0,20,0,4"/>
            <CheckBox x:Name="MaterialsCheck" Content="Materiales, texturas y reflejos" IsChecked="True"/>
            <CheckBox x:Name="LightingCheck" Content="Iluminación realista" IsChecked="True"/>
            <CheckBox x:Name="ShadowsCheck" Content="Sombras y oclusión de contacto" IsChecked="True"/>
            <CheckBox x:Name="TreesCheck" Content="Árboles realistas"/>
            <CheckBox x:Name="VegetationCheck" Content="Césped y vegetación"/>
            <CheckBox x:Name="FurnitureCheck" Content="Mobiliario y decoración"/>
            <CheckBox x:Name="PeopleCheck" Content="Personas realistas"/>
            <CheckBox x:Name="SkyCheck" Content="Cielo y atmósfera" IsChecked="True"/>
            <CheckBox x:Name="PreserveCheck" Content="Respetar geometría, cámara y fachadas" IsChecked="True"/>
            <TextBlock Text="INSTRUCCIONES ADICIONALES" FontSize="12" FontWeight="Bold" Foreground="#75E3CF" Margin="0,21,0,8"/>
            <TextBox x:Name="NotesBox" Height="89" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="2000"
                     ToolTip="Ejemplo: conservar el tono gris de los muros y el pavimento original."/>
            <TextBlock Text="Solo se agregan las mejoras que marques. El prompt conserva el encuadre de la vista capturada."
                       Foreground="#9DB0C1" FontSize="11" TextWrapping="Wrap" Margin="0,15,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="160"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="110"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="110"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="IMAGEN DE REFERENCIA · VISTA ACTUAL" FontSize="12" FontWeight="Bold" Foreground="#75E3CF" Margin="0,0,0,8"/>
        <Border Grid.Row="1" Background="#0D1722" BorderBrush="#40596B" BorderThickness="1" CornerRadius="8">
          <Image x:Name="ReferenceImage" Stretch="Uniform" Margin="5"/>
        </Border>
        <TextBlock Grid.Row="2" Text="PROMPT GENERADO (.md)" FontSize="12" FontWeight="Bold" Foreground="#75E3CF" Margin="0,17,0,8"/>
        <TextBox Grid.Row="3" x:Name="PromptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 ToolTip="Selecciona un render guardado para ver el prompt de esa sesión."/>
        <TextBlock Grid.Row="4" Text="BAÚL DE RENDERS · SESIONES GUARDADAS" FontSize="12" FontWeight="Bold"
                   Foreground="#75E3CF" Margin="0,17,0,8"/>
        <ListBox Grid.Row="5" x:Name="PackagesList" DisplayMemberPath="DisplayName"
                 SelectionChanged="PackagesList_SelectionChanged"
                 Background="#192B3B" Foreground="#EAF0F6" BorderBrush="#3E556A"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Importar resultado de IA" Click="ImportResult_Click"
                  ToolTip="Guarda una imagen PNG/JPEG en la sesión elegida junto al prompt original."/>
          <Button Content="Abrir baúl" Click="OpenVault_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="StatusText" Text="Elige tus opciones y pulsa Preparar paquete."
                 Foreground="#9FDACA" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
        <Button Content="Preparar paquete" Background="#257E75" BorderBrush="#4BB9AA" FontWeight="SemiBold"
                Click="Prepare_Click" ToolTip="Guarda prompt.md y referencia.png en el baúl."/>
        <Button Content="Copiar prompt" Click="CopyPrompt_Click"/>
        <Button Content="Copiar imagen" Click="CopyReference_Click"/>
        <Button Content="Cerrar" Click="Close_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
