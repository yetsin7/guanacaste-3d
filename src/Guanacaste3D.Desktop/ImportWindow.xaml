<Window x:Class="Guanacaste3D.Desktop.ImportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{DynamicResource Import.Title}" Width="620" SizeToContent="Height" MinHeight="420"
  WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource AppBackgroundBrush}"
  FontFamily="Segoe UI Variable Display, Segoe UI" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="FileNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock x:Name="FileDetailText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock x:Name="SummaryText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <ItemsControl x:Name="NotesList" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Border x:Name="PreviewBorder" Grid.Column="1" Margin="16,0,0,0" Width="136" Height="136" Background="White"
              BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
    </Grid>

    <GroupBox x:Name="OptionsBox" Grid.Row="1" Header="{DynamicResource Import.Options}" Margin="0,16,0,0" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Import.Units}" VerticalAlignment="Center"/>
        <ComboBox x:Name="UnitsPicker" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,8">
          <ComboBoxItem Content="{DynamicResource Import.UnitsAuto}" Tag="auto"/>
          <ComboBoxItem Content="{DynamicResource Import.UnitsMeters}" Tag="1"/>
          <ComboBoxItem Content="{DynamicResource Import.UnitsCentimeters}" Tag="0.01"/>
          <ComboBoxItem Content="{DynamicResource Import.UnitsMillimeters}" Tag="0.001"/>
          <ComboBoxItem Content="{DynamicResource Import.UnitsFeet}" Tag="0.3048"/>
          <ComboBoxItem Content="{DynamicResource Import.UnitsInches}" Tag="0.0254"/>
        </ComboBox>
        <TextBlock Grid.Row="1" Text="{DynamicResource Import.UpAxis}" VerticalAlignment="Center"/>
        <ComboBox x:Name="UpAxisPicker" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,8">
          <ComboBoxItem Content="{DynamicResource Import.UpAuto}" Tag="Auto"/>
          <ComboBoxItem Content="{DynamicResource Import.UpZ}" Tag="Z"/>
          <ComboBoxItem Content="{DynamicResource Import.UpY}" Tag="Y"/>
        </ComboBox>
        <CheckBox x:Name="CenterCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="{DynamicResource Import.Center}" Margin="0,0,0,6"/>
        <CheckBox x:Name="GroundCheck" Grid.Row="3" Grid.ColumnSpan="2" Content="{DynamicResource Import.Ground}"/>
      </Grid>
    </GroupBox>

    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="ImportButton" Content="{DynamicResource Import.Import}" Padding="18,6" IsDefault="True" Click="Import_Click"/>
      <Button x:Name="CancelButton" Content="{DynamicResource Import.Cancel}" Padding="18,6" Margin="8,0,0,0" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
