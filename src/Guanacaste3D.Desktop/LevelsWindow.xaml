<Window x:Class="Guanacaste3D.Desktop.LevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Levels.WindowTitle}" Width="860" Height="560" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Parameters.Close}" Click="Close_Click" MinWidth="90" IsCancel="True"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Levels.Header}" Style="{StaticResource PanelHeaderStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="UndoButton" Content="{DynamicResource Action.Undo}" Click="Undo_Click" MinWidth="80" Margin="0,0,4,0"/>
              <Button x:Name="RedoButton" Content="{DynamicResource Action.Redo}" Click="Redo_Click" MinWidth="80"/>
            </StackPanel>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Levels.Hint}" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
          <ListBox x:Name="LevelsList" SelectionChanged="LevelsList_SelectionChanged" BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <StackPanel>
          <TextBlock Text="{DynamicResource Levels.EditorHeader}" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8"/>
          <TextBlock Text="{DynamicResource Parameters.Name}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="NameBox" MaxLength="100"/>
          <TextBlock Text="{DynamicResource Levels.Elevation}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
          <TextBox x:Name="ElevationBox"/>
          <TextBlock x:Name="DependentsText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
          <UniformGrid Columns="3" Margin="0,10,0,0">
            <Button Content="{DynamicResource Levels.Add}" Click="Add_Click" Margin="0,0,4,0"/>
            <Button Content="{DynamicResource Parameters.Apply}" Click="Apply_Click" Margin="2,0"/>
            <Button x:Name="DeleteLevelButton" Content="{DynamicResource Parameters.Delete}" Click="Delete_Click" Margin="4,0,0,0"/>
          </UniformGrid>
          <Separator Margin="0,14,0,10"/>
          <TextBlock Text="{DynamicResource Levels.ConstraintsHeader}" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,6"/>
          <TextBlock Text="{DynamicResource Levels.TopOffset}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="OffsetBox" Text="0"/>
          <Button Content="{DynamicResource Levels.Attach}" Click="Attach_Click" Margin="0,8,0,0" Padding="6,3"/>
          <Button Content="{DynamicResource Levels.Detach}" Click="Detach_Click" Margin="0,6,0,0" Padding="6,3"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
