<Window x:Class="Guanacaste3D.Desktop.CommandCustomizationWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{DynamicResource CommandCustomization.Title}" Width="820" Height="640"
  MinWidth="680" MinHeight="500" WindowStartupLocation="CenterOwner"
  Background="{DynamicResource AppBackgroundBrush}" FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource CommandCustomization.Title}" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource CommandCustomization.Description}" Margin="0,5,0,16"
                 Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}"
                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="2,0,8,0"/>
        <TextBox x:Name="SearchInput" TextChanged="SearchInput_TextChanged"
                 ToolTip="{DynamicResource CommandCustomization.Search}" BorderThickness="0"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="1">
      <DataGrid x:Name="CommandGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                BorderThickness="0" RowHeight="36" AlternatingRowBackground="#FAFBFC">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="{DynamicResource CommandCustomization.QuickAccess}" Binding="{Binding IsQuickAccess}" Width="110"/>
          <DataGridTextColumn Header="{DynamicResource CommandCustomization.Command}" Binding="{Binding Label}" IsReadOnly="True" Width="2*"/>
          <DataGridTextColumn Header="{DynamicResource CommandCustomization.Workspace}" Binding="{Binding Workspace}" IsReadOnly="True" Width="*"/>
          <DataGridTextColumn Header="{DynamicResource CommandCustomization.Shortcut}" Binding="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Button Content="{DynamicResource CommandCustomization.Reset}" Click="Reset_Click"
              HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource Action.Cancel}" Click="Cancel_Click" MinWidth="92"/>
        <Button Content="{DynamicResource Action.Save}" Click="Save_Click" MinWidth="104"
                Background="{DynamicResource AccentBrush}" Foreground="White"
                BorderBrush="{DynamicResource AccentBrush}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
