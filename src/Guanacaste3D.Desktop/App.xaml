<Application x:Class="Guanacaste3D.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="resources/icons.xaml"/>
        <ResourceDictionary Source="resources/icons.contextual.xaml"/>
        <ResourceDictionary Source="resources/icons-professional.xaml"/>
        <ResourceDictionary Source="resources/icons.commands.xaml"/>
        <ResourceDictionary Source="resources/theme.xaml"/>
        <ResourceDictionary Source="resources/brand.xaml"/>
        <ResourceDictionary Source="resources/localization.splash.es.xaml"/>
        <ResourceDictionary Source="resources/localization.es.xaml"/>
        <ResourceDictionary Source="resources/localization.ribbons.es.xaml"/>
        <ResourceDictionary Source="resources/localization.customization.es.xaml"/>
        <ResourceDictionary Source="resources/localization.parameters.es.xaml"/>
        <ResourceDictionary Source="resources/localization.errors.es.xaml"/>
        <ResourceDictionary Source="resources/localization.in-place.es.xaml"/>
        <ResourceDictionary Source="resources/localization.structure.es.xaml"/>
        <ResourceDictionary Source="resources/localization.render-engine.es.xaml"/>
        <ResourceDictionary Source="resources/localization.import.es.xaml"/>
        <ResourceDictionary Source="resources/localization.render.es.xaml"/>
        <ResourceDictionary Source="resources/localization.view3d.es.xaml"/>
        <ResourceDictionary Source="resources/localization.architecture.es.xaml"/>
        <ResourceDictionary Source="resources/localization.electrical.es.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type ToolTip}">
        <Setter Property="StaysOpen" Value="False"/>
        <EventSetter Event="Opened" Handler="ToolTip_Opened"/>
        <EventSetter Event="Closed" Handler="ToolTip_Closed"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
