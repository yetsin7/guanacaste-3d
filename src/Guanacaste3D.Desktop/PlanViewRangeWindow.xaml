<Window x:Class="Guanacaste3D.Desktop.PlanViewRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ViewRange.Title}" Width="500" Height="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource ViewRange.Level}" Foreground="{DynamicResource SecondaryTextBrush}"/>
    <TextBlock x:Name="LevelText" Grid.Row="1" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,14"/>
    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16">
      <Button Content="{DynamicResource ViewRange.Architectural}" Click="Architectural_Click" Margin="0,0,4,0"/>
      <Button Content="{DynamicResource ViewRange.Ceiling}" Click="Ceiling_Click" Margin="2,0"/>
      <Button Content="{DynamicResource ViewRange.FullLevel}" Click="FullLevel_Click" Margin="4,0,0,0"/>
    </UniformGrid>
    <TextBlock Grid.Row="3" Text="{DynamicResource ViewRange.Bottom}" Foreground="{DynamicResource SecondaryTextBrush}"/>
    <TextBox x:Name="BottomBox" Grid.Row="4" Margin="0,4,0,10"/>
    <StackPanel Grid.Row="5">
      <TextBlock Text="{DynamicResource ViewRange.Cut}" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBox x:Name="CutBox" Margin="0,4,0,10"/>
      <TextBlock Text="{DynamicResource ViewRange.Top}" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBox x:Name="TopBox" Margin="0,4,0,10"/>
    </StackPanel>
    <TextBlock Grid.Row="6" Text="{DynamicResource ViewRange.Explanation}" TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,12"/>
    <TextBlock x:Name="ValidationText" Grid.Row="7" Foreground="#B42318" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource Dialog.Cancel}" IsCancel="True" MinWidth="86" Margin="0,0,6,0"/>
      <Button Content="{DynamicResource Dialog.Accept}" IsDefault="True" MinWidth="86" Click="Accept_Click"/>
    </StackPanel>
  </Grid>
</Window>
