<Window x:Class="Guanacaste3D.Desktop.LinkedModelsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{DynamicResource Links.Title}" Width="860" Height="520" MinWidth="720" MinHeight="420"
  WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
  FontFamily="Segoe UI Variable Display, Segoe UI" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Grid.Column="0">
      <ListView x:Name="LinkList" SelectionMode="Single" SelectionChanged="LinkList_SelectionChanged">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{DynamicResource Links.Visible}" Width="64">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Checked="Visible_Changed" Unchecked="Visible_Changed"
                            HorizontalAlignment="Center"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{DynamicResource Links.Name}" DisplayMemberBinding="{Binding Name}" Width="220"/>
            <GridViewColumn Header="{DynamicResource Links.Triangles}" DisplayMemberBinding="{Binding Triangles}" Width="90"/>
            <GridViewColumn Header="{DynamicResource Links.State}" DisplayMemberBinding="{Binding State}" Width="150"/>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock x:Name="EmptyText" Text="{DynamicResource Links.Empty}" TextWrapping="Wrap" TextAlignment="Center"
                 VerticalAlignment="Center" Margin="40" Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"/>
    </Grid>

    <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" x:Name="DetailPanel" IsEnabled="False">
      <TextBlock Text="{DynamicResource Links.Path}" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock x:Name="PathText" TextWrapping="Wrap" Margin="0,2,0,12" FontSize="11"/>
      <TextBlock Text="{DynamicResource Links.Placement}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="{DynamicResource Links.OffsetX}"/>
      <TextBox x:Name="OffsetXInput" Margin="0,2,0,6"/>
      <TextBlock Text="{DynamicResource Links.OffsetY}"/>
      <TextBox x:Name="OffsetYInput" Margin="0,2,0,6"/>
      <TextBlock Text="{DynamicResource Links.OffsetZ}"/>
      <TextBox x:Name="OffsetZInput" Margin="0,2,0,6"/>
      <TextBlock Text="{DynamicResource Links.Rotation}"/>
      <TextBox x:Name="RotationInput" Margin="0,2,0,6"/>
      <TextBlock Text="{DynamicResource Links.Scale}"/>
      <TextBox x:Name="ScaleInput" Margin="0,2,0,10"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Links.Apply}" Padding="14,5" Click="Apply_Click"/>
        <Button Content="{DynamicResource Links.Reload}" Padding="14,5" Margin="8,0,0,0" Click="Reload_Click"/>
        <Button Content="{DynamicResource Links.Remove}" Padding="14,5" Margin="8,0,0,0" Click="Remove_Click"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{DynamicResource Links.Add}" Padding="18,6" Click="Add_Click"/>
      <Button Content="{DynamicResource Import.Close}" Padding="18,6" Margin="8,0,0,0" IsDefault="True" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
