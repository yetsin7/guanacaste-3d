<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Electrical system: devices, wiring, switching and the panel schedule (Spanish). -->

  <!-- Ribbon -->
  <sys:String x:Key="RibbonCommand.Wire">Cableado</sys:String>
  <sys:String x:Key="RibbonCommand.LightingFixture">Luminaria</sys:String>
  <sys:String x:Key="RibbonCommand.ElectricalDevice">Tomacorriente</sys:String>
  <sys:String x:Key="RibbonCommand.LightSwitch">Apagador</sys:String>
  <sys:String x:Key="RibbonCommand.PanelSchedule">Cuadro de cargas</sys:String>

  <!-- Device kinds -->
  <sys:String x:Key="Electrical.Kind.Outlet">Tomacorriente doble</sys:String>
  <sys:String x:Key="Electrical.Kind.GfciOutlet">Tomacorriente GFCI</sys:String>
  <sys:String x:Key="Electrical.Kind.UsbOutlet">Tomacorriente con USB</sys:String>
  <sys:String x:Key="Electrical.Kind.Outlet240">Tomacorriente 240 V</sys:String>
  <sys:String x:Key="Electrical.Kind.Switch">Apagador sencillo</sys:String>
  <sys:String x:Key="Electrical.Kind.ThreeWaySwitch">Apagador de 3 vías</sys:String>
  <sys:String x:Key="Electrical.Kind.Dimmer">Atenuador (dimmer)</sys:String>
  <sys:String x:Key="Electrical.Kind.CeilingFixture">Plafón de techo</sys:String>
  <sys:String x:Key="Electrical.Kind.Downlight">Luminaria empotrada</sys:String>
  <sys:String x:Key="Electrical.Kind.WallSconce">Aplique de pared</sys:String>
  <sys:String x:Key="Electrical.Kind.Pendant">Lámpara colgante</sys:String>
  <sys:String x:Key="Electrical.Kind.Panel">Tablero eléctrico</sys:String>

  <!-- States -->
  <sys:String x:Key="Electrical.Lit">Encendida</sys:String>
  <sys:String x:Key="Electrical.Dark">Apagada</sys:String>
  <sys:String x:Key="Electrical.On">Encendido</sys:String>
  <sys:String x:Key="Electrical.Off">Apagado</sys:String>
  <sys:String x:Key="Electrical.Energized">Con energía</sys:String>
  <sys:String x:Key="Electrical.NoPower">Sin energía</sys:String>
  <sys:String x:Key="Electrical.NoCircuit">Sin circuito</sys:String>
  <sys:String x:Key="Electrical.CircuitName">Circuito {0}</sys:String>
  <sys:String x:Key="Properties.ElectricalSummary">{0}&#x0a;Tipo: {1}&#x0a;Circuito: {2}&#x0a;Carga: {3:0} W&#x0a;Estado: {4}&#x0a;Altura: {5:0.00} m&#x0a;Controla: {6} luminarias&#x0a;Doble clic o Espacio acciona un apagador.</sys:String>

  <!-- Status -->
  <sys:String x:Key="Status.ElectricalPlace">{0}: haz clic para colocarlo (junto a un muro si va en muro). Espacio cambia de tipo; Esc termina.</sys:String>
  <sys:String x:Key="Status.ElectricalNeedsWall">Este dispositivo va en un muro: haz clic cerca de la cara de un muro.</sys:String>
  <sys:String x:Key="Status.ElectricalPlaced">{0} colocado. Sigue haciendo clic o pulsa Esc.</sys:String>
  <sys:String x:Key="Status.WiringPickSource">Cableado: haz clic en un apagador para conectar luces, o en un tablero para crear un circuito. Esc termina.</sys:String>
  <sys:String x:Key="Status.WiringPickLuminaire">Haz clic en una luminaria o lámpara para conectarla al apagador (otra vez la desconecta).</sys:String>
  <sys:String x:Key="Status.WiringLinked">Luminaria conectada al apagador.</sys:String>
  <sys:String x:Key="Status.WiringUnlinked">Luminaria desconectada del apagador.</sys:String>
  <sys:String x:Key="Status.WiringPickDevice">Haz clic en los dispositivos que alimenta el circuito (otra vez lo desconecta).</sys:String>
  <sys:String x:Key="Status.WiringSwitchPicked">{0}: haz clic en las luminarias que controla (otra vez para desconectar).</sys:String>
  <sys:String x:Key="Status.WiringCircuitStarted">Circuito {0} creado con breaker de 20 A: haz clic en los dispositivos que alimenta.</sys:String>
  <sys:String x:Key="Status.CircuitTripped">¡El breaker del circuito {0} se disparó! {1} dispositivos, {2:0} W = {3:0.0} A sobre un breaker de {4:0} A ({5:0} %).</sys:String>
  <sys:String x:Key="Status.CircuitLoad">Circuito {0}: {1} dispositivos, {2:0} W, {3:0.0} A de {4:0} A ({5:0} %).</sys:String>
  <sys:String x:Key="Status.SwitchOn">{0}: encendido.</sys:String>
  <sys:String x:Key="Status.SwitchOff">{0}: apagado.</sys:String>
  <sys:String x:Key="Status.NoPanel">Coloca primero un tablero eléctrico (Sistemas → Equipo eléctrico).</sys:String>

  <!-- Panel schedule -->
  <sys:String x:Key="PanelSchedule.Title">Tablero eléctrico — cuadro de cargas</sys:String>
  <sys:String x:Key="PanelSchedule.PanelHeader">{0}: principal {1:0} A · carga {2:0.00} kW · {3:0.0} A ({4:0} %) · {5}</sys:String>
  <sys:String x:Key="PanelSchedule.Number">#</sys:String>
  <sys:String x:Key="PanelSchedule.Name">Circuito</sys:String>
  <sys:String x:Key="PanelSchedule.Breaker">Breaker (A)</sys:String>
  <sys:String x:Key="PanelSchedule.Devices">Dispositivos</sys:String>
  <sys:String x:Key="PanelSchedule.Load">Carga</sys:String>
  <sys:String x:Key="PanelSchedule.Current">Corriente</sys:String>
  <sys:String x:Key="PanelSchedule.Use">Uso</sys:String>
  <sys:String x:Key="PanelSchedule.Conductor">Conductor</sys:String>
  <sys:String x:Key="PanelSchedule.Length">Longitud</sys:String>
  <sys:String x:Key="PanelSchedule.Drop">Caída de tensión</sys:String>
  <sys:String x:Key="PanelSchedule.State">Estado</sys:String>
  <sys:String x:Key="PanelSchedule.NewCircuit">Nuevo circuito</sys:String>
  <sys:String x:Key="PanelSchedule.ToggleBreaker">Abrir / cerrar breaker</sys:String>
  <sys:String x:Key="PanelSchedule.Larger">Breaker mayor</sys:String>
  <sys:String x:Key="PanelSchedule.Smaller">Breaker menor</sys:String>
  <sys:String x:Key="PanelSchedule.Rename">Renombrar circuito</sys:String>
  <sys:String x:Key="PanelSchedule.Remove">Eliminar circuito</sys:String>
  <sys:String x:Key="PanelSchedule.MainBreaker">Abrir / cerrar principal</sys:String>
  <sys:String x:Key="PanelSchedule.Notes">Carga conectada: potencia de cada luminaria y 180 VA por tomacorriente (NEC 220.14). Por encima del 80 % del breaker hay advertencia para cargas continuas; por encima del 100 % el breaker se dispara y el circuito queda sin energía, y sus luces se apagan en el render. Conductor de cobre THHN según NEC 240.4(D); se recomienda una caída de tensión de 3 % como máximo.</sys:String>
  <sys:String x:Key="CircuitStatus.Empty">Sin carga</sys:String>
  <sys:String x:Key="CircuitStatus.Ok">Correcto</sys:String>
  <sys:String x:Key="CircuitStatus.Warning">Advertencia (&gt; 80 %)</sys:String>
  <sys:String x:Key="CircuitStatus.Off">Breaker abierto</sys:String>
  <sys:String x:Key="CircuitStatus.Tripped">¡Disparado!</sys:String>

  <!-- Transactions -->
  <sys:String x:Key="Transaction.AddElectricalDevice">Colocar dispositivo eléctrico</sys:String>
  <sys:String x:Key="Transaction.RemoveElectricalDevice">Eliminar dispositivo eléctrico</sys:String>
  <sys:String x:Key="Transaction.ToggleSwitch">Accionar apagador</sys:String>
  <sys:String x:Key="Transaction.SetDimLevel">Regular atenuador</sys:String>
  <sys:String x:Key="Transaction.SetDeviceLoad">Cambiar carga del dispositivo</sys:String>
  <sys:String x:Key="Transaction.LinkSwitch">Conectar apagador</sys:String>
  <sys:String x:Key="Transaction.UnlinkSwitch">Desconectar apagador</sys:String>
  <sys:String x:Key="Transaction.AddCircuit">Crear circuito</sys:String>
  <sys:String x:Key="Transaction.AssignCircuit">Asignar circuito</sys:String>
  <sys:String x:Key="Transaction.SetBreaker">Cambiar breaker</sys:String>
  <sys:String x:Key="Transaction.RenameCircuit">Renombrar circuito</sys:String>
  <sys:String x:Key="Transaction.RemoveCircuit">Eliminar circuito</sys:String>
  <sys:String x:Key="Transaction.MoveElectricalDevice">Mover dispositivo eléctrico</sys:String>
</ResourceDictionary>
