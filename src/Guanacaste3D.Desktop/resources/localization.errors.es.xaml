  <sys:String x:Key="Error.FormulaWord.Missing ']'">falta «]»</sys:String>
  <sys:String x:Key="Error.FormulaWord.Empty reference">referencia vacía</sys:String>
  <sys:String x:Key="Error.FormulaWord.Invalid number">número no válido</sys:String>
  <sys:String x:Key="Error.FormulaWord.Missing closing quote">faltan las comillas de cierre</sys:String>
