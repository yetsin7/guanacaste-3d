  <sys:String x:Key="Error.Formula.Syntax">Error de fórmula: {0} (carácter {1}).</sys:String>
  <sys:String x:Key="Error.FormulaWord.number">número</sys:String>
  <sys:String x:Key="Error.FormulaWord.length">longitud</sys:String>
  <sys:String x:Key="Error.FormulaWord.area">área</sys:String>
  <sys:String x:Key="Error.FormulaWord.volume">volumen</sys:String>
