  <sys:String x:Key="Error.A wall height does not match its top constraint.">La altura de un muro no coincide con su restricción superior.</sys:String>
  <sys:String x:Key="Error.The level does not exist.">El nivel no existe.</sys:String>
  <sys:String x:Key="Error.Level names must be unique.">Ya existe un nivel con ese nombre.</sys:String>
  <sys:String x:Key="Error.A project needs at least one level.">El proyecto necesita al menos un nivel.</sys:String>
