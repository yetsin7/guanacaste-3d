<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#E9EDF0"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#22292F"/>
  <SolidColorBrush x:Key="RibbonBrush" Color="#F8F9FA"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#C9D0D5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#007FA3"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#D9EEF4"/>
  <SolidColorBrush x:Key="ContextualBarBrush" Color="#E3F3F7"/>
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1E272E"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#61707B"/>
  <SolidColorBrush x:Key="CanvasBrush" Color="#F8FAFB"/>

  <Style TargetType="Button">
    <Setter Property="Padding" Value="11,6"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#BFC8CE"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
  </Style>
  <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="MinHeight" Value="54"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="PrimaryRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonButtonStyle}">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="#A9CCBC"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="Margin" Value="12,12,8,8"/>
  </Style>
  <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="#35515B"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="ContextualButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="Background" Value="#F8FCFD"/>
    <Setter Property="BorderBrush" Value="#78AAB9"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="#BFC8CE"/>
    <Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="7,5"/>
    <Setter Property="MinHeight" Value="31"/>
  </Style>
</ResourceDictionary>
