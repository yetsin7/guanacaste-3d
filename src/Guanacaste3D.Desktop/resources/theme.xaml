<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#FBFBFD"/>
  <SolidColorBrush x:Key="RibbonBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#FBFBFD"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#D8D8DD"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#006ADC"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF3FF"/>
  <SolidColorBrush x:Key="ContextualBarBrush" Color="#F0F7FF"/>
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73"/>
  <SolidColorBrush x:Key="CanvasBrush" Color="#ECEDEF"/>
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#C7C7CC"/>
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F0F2"/>

  <Style TargetType="Button">
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#AEAEB2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuickAccessButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="30"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="Margin" Value="1"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <Style x:Key="BrowserToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickAccessButtonStyle}">
    <Setter Property="Width" Value="29"/>
    <Setter Property="Height" Value="27"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Padding" Value="5"/>
  </Style>

  <!-- Ribbon button: the Tag icon stacked above a wrapped caption, with hover feedback. -->
  <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="68"/>
    <Setter Property="MaxWidth" Value="92"/>
    <Setter Property="MinHeight" Value="62"/>
    <Setter Property="Padding" Value="6,6"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="7" BorderThickness="1"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel VerticalAlignment="Center">
              <Image Source="{TemplateBinding Tag}" Width="26" Height="26" Stretch="Uniform"
                     Margin="0,0,0,5" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap"
                         LineHeight="13" LineStackingStrategy="BlockLineHeight"
                         Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#D2E4FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonButtonStyle}">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="#B8D7FF"/>
    <Setter Property="Foreground" Value="#005BBB"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="RibbonGroupBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="#DADDE1"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="Padding" Value="4,0,5,0"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="3,2,3,0"/>
  </Style>

  <Style x:Key="CompactRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="104"/>
    <Setter Property="Height" Value="25"/>
    <Setter Property="MinHeight" Value="25"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="CompactSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{TemplateBinding CommandParameter}" Width="16" Height="16"
                     Margin="0,0,5,0" Stretch="Uniform"/>
              <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}" FontSize="11"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CompactSurface" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
              <Setter TargetName="CompactSurface" Property="BorderBrush" Value="#D2E4F0"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="CompactSurface" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LargeRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="61"/>
    <Setter Property="Height" Value="75"/>
    <Setter Property="MinHeight" Value="75"/>
    <Setter Property="Padding" Value="5,4"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="LargeSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <StackPanel>
              <Image Source="{TemplateBinding CommandParameter}" Width="29" Height="29"
                     Margin="0,1,0,4" Stretch="Uniform"/>
              <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{TemplateBinding Foreground}" FontSize="11"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="LargeSurface" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
              <Setter TargetName="LargeSurface" Property="BorderBrush" Value="#D2E4F0"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="LargeSurface" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RibbonFieldLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FontSize" Value="10"/>
  </Style>

  <Style x:Key="RibbonFieldButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="25"/>
    <Setter Property="MinHeight" Value="25"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="#B8D7FF"/>
    <Setter Property="Foreground" Value="#005BBB"/>
  </Style>

  <Style x:Key="RibbonTabItemStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="17,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Background="Transparent" CornerRadius="7,7,0,0"
                  Padding="{TemplateBinding Padding}" Margin="1,0">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="#F0F0F2"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
              <Setter Property="Foreground" Value="#005BBB"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="ViewTabSurface" Background="#F5F5F7" BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ViewTabSurface" Property="Background" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ViewTabSurface" Property="Background" Value="#FFFFFF"/>
              <Setter TargetName="ViewTabSurface" Property="BorderThickness" Value="0,0,1,0"/>
              <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="Margin" Value="14,13,10,9"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style x:Key="PropertySectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="Background" Value="#EEF0F2"/>
    <Setter Property="Foreground" Value="#343A40"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>

  <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="12,8,12,3"/>
  </Style>

  <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="#3A3A3C"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ContextualButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="11,3"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#A9CBF4"/>
    <Setter Property="Foreground" Value="#005BBB"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="SelectionBrush" Value="#77B7FF"/>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="31"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
  </Style>

  <Style TargetType="TreeView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
  </Style>
</ResourceDictionary>
