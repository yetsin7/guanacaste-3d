<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Guanacaste3D.Desktop.Controls">
  <!-- Palette sampled from the classic light BIM workstation look: grey chrome, near-white ribbon,
       white property grid and canvas, system-blue selection. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#D9D9D9"/>
  <SolidColorBrush x:Key="RibbonBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="RibbonSeparatorBrush" Color="#E2E2E2"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="PanelHeaderBrush" Color="#D9D9D9"/>
  <SolidColorBrush x:Key="PanelToolbarBrush" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#C1C1C1"/>
  <SolidColorBrush x:Key="PropertyGroupBrush" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="PropertyGridLineBrush" Color="#ECECEC"/>
  <SolidColorBrush x:Key="ViewTabStripBrush" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="ViewControlBarBrush" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="FileTabBrush" Color="#2B7BB3"/>
  <SolidColorBrush x:Key="FileTabHoverBrush" Color="#3A8CC6"/>
  <SolidColorBrush x:Key="ContextualTabBrush" Color="#87B340"/>
  <SolidColorBrush x:Key="ContextualTabSoftBrush" Color="#EAEFE3"/>
  <SolidColorBrush x:Key="ContextualTabTextBrush" Color="#4F6B2A"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F3FB"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#0078D7"/>
  <SolidColorBrush x:Key="InactiveSelectionBrush" Color="#D9D9D9"/>
  <SolidColorBrush x:Key="RibbonHoverBrush" Color="#E5F3FB"/>
  <SolidColorBrush x:Key="RibbonHoverBorderBrush" Color="#9ACDEB"/>
  <SolidColorBrush x:Key="RibbonPressedBrush" Color="#C2E3F2"/>
  <LinearGradientBrush x:Key="RibbonCheckedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DDEEF6" Offset="0"/>
    <GradientStop Color="#C2E3F2" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="RibbonCheckedBorderBrush" Color="#79C4E7"/>
  <SolidColorBrush x:Key="ContextualBarBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="RibbonTextBrush" Color="#3C3C3C"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6D6D6D"/>
  <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#ABADB3"/>
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#E5F3FB"/>
  <!-- Ribbon icons sit directly on the ribbon surface, without decorative tiles. -->
  <SolidColorBrush x:Key="IconTileBrush" Color="Transparent"/>
  <FontFamily x:Key="GlyphFont">Segoe MDL2 Assets</FontFamily>

  <!-- Dialog push button: flat light face, thin grey frame, accent frame for the default action. -->
  <Style TargetType="Button">
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Background" Value="#FDFDFD"/>
    <Setter Property="BorderBrush" Value="#CCCCCC"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDefault" Value="True">
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonSurface" Property="Background" Value="#E5F1FB"/>
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#0078D7"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonSurface" Property="Background" Value="#CCE4F7"/>
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#005499"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonSurface" Property="Background" Value="#F4F4F4"/>
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#DADADA"/>
              <Setter Property="Foreground" Value="#A0A0A0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Borderless icon button for the title-bar quick access toolbar. -->
  <Style x:Key="QuickAccessButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BrowserToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickAccessButtonStyle}">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="3"/>
  </Style>

  <!-- Window caption buttons drawn with the system glyph font. -->
  <Style x:Key="CaptionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#C8C8C8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#B4B4B4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#E81123"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#F1707A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Blue application tab at the left of the ribbon tab row; opens the file menu. -->
  <Style x:Key="FileTabButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="11,2"/>
    <Setter Property="Margin" Value="1,0,0,0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{StaticResource FileTabBrush}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource FileTabHoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ribbon button: the Tag icon stacked above a wrapped caption. -->
  <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="44"/>
    <Setter Property="MaxWidth" Value="104"/>
    <Setter Property="MinHeight" Value="72"/>
    <Setter Property="Padding" Value="3,2"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" BorderThickness="1"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel VerticalAlignment="Top">
              <Image Source="{TemplateBinding Tag}" Width="32" Height="32" Margin="0,0,0,3" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap"
                         LineHeight="15" LineStackingStrategy="BlockLineHeight"
                         Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The active tool shown as a latched ribbon button. -->
  <Style x:Key="PrimaryRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonButtonStyle}">
    <Setter Property="Background" Value="{StaticResource RibbonCheckedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RibbonCheckedBorderBrush}"/>
  </Style>

  <!-- Ribbon panel: commands on top, title underneath, thin divider on the right. -->
  <Style x:Key="RibbonGroupBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource RibbonSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="3,2,3,0"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <!-- Icon-only ribbons are narrow enough to fit. If a very small window still overflows, the wheel pans
       sideways; there is deliberately no scroll bar. -->
  <Style x:Key="RibbonScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="controls:RibbonScroll.WheelScrollsHorizontally" Value="True"/>
    <Setter Property="PanningMode" Value="HorizontalOnly"/>
  </Style>

  <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="3,0,3,1"/>
  </Style>

  <!-- Small ribbon command: a 22 px icon only; three stack per column. The name appears in the tooltip. -->
  <Style x:Key="CompactRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="CompactSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image Source="{TemplateBinding CommandParameter}" Width="22" Height="22" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="MenuArrow" Text="&#x25BE;" FontSize="9" Margin="2,0,0,0" Visibility="Collapsed"
                         VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:RibbonButton.HasMenu" Value="True">
              <Setter TargetName="MenuArrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CompactSurface" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
              <Setter TargetName="CompactSurface" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="CompactSurface" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="CompactSurface" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Large ribbon command: a 40 px icon only, as tall as three stacked small commands. -->
  <Style x:Key="LargeRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="48"/>
    <Setter Property="Height" Value="78"/>
    <Setter Property="MinHeight" Value="78"/>
    <Setter Property="Padding" Value="3,2"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="LargeSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Image Source="{TemplateBinding CommandParameter}" Width="40" Height="40" Stretch="Uniform"
                     VerticalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="MenuArrow" Text="&#x25BE;" FontSize="11" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Foreground="{TemplateBinding Foreground}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:RibbonButton.HasMenu" Value="True">
              <Setter TargetName="MenuArrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="LargeSurface" Property="Background" Value="{StaticResource RibbonHoverBrush}"/>
              <Setter TargetName="LargeSurface" Property="BorderBrush" Value="{StaticResource RibbonHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="LargeSurface" Property="Background" Value="{StaticResource RibbonPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="LargeSurface" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RibbonFieldLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="RibbonFieldButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="23"/>
    <Setter Property="MinHeight" Value="23"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- Ribbon tab row: grey strip, blue file tab on the left, selected tab merges into the ribbon. -->
  <Style x:Key="RibbonTabControlStyle" TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}">
              <DockPanel Margin="0,3,0,0">
                <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding Tag}"/>
                <TabPanel IsItemsHost="True" Margin="1,0,0,0" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1"/>
              </DockPanel>
            </Border>
            <Border Background="{StaticResource RibbonBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1">
              <ContentPresenter ContentSource="SelectedContent" Margin="0,0,0,1"/>
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RibbonTabItemStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource RibbonTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="9,2,9,3"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                  BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,1,0">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="#E8E8E8"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource RibbonBrush}"/>
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="#CFCFCF"/>
              <Setter TargetName="TabSurface" Property="Margin" Value="0,0,1,-1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Contextual tab (e.g. "Modificar | Muros"): green frame and text while a tool is active. -->
  <Style x:Key="ContextualRibbonTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource RibbonTabItemStyle}">
    <Setter Property="Foreground" Value="{StaticResource ContextualTabTextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Background="{StaticResource ContextualTabSoftBrush}"
                  BorderBrush="{StaticResource ContextualTabBrush}" BorderThickness="1,1,1,0"
                  Padding="{TemplateBinding Padding}" Margin="0,0,1,0">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="Margin" Value="0,0,1,-1"/>
              <Setter TargetName="TabSurface" Property="BorderThickness" Value="1,2,1,0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Document view tabs: grey strip, white active tab with a view glyph. -->
  <Style x:Key="WorkspaceTabControlStyle" TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource ViewTabStripBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" Margin="2,2,0,0" Panel.ZIndex="1"/>
            </Border>
            <ContentPresenter ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,2,4,3"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="ViewTabSurface" Background="#E6E6E6" BorderBrush="#ACACAC"
                  BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
            <StackPanel Orientation="Horizontal">
              <Image Source="{TemplateBinding Tag}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              <!-- Closes the view; handled by the window through the button's name. -->
              <Button x:Name="CloseViewButton" Width="16" Height="16" Margin="8,0,0,0" Padding="0" Focusable="False"
                      VerticalAlignment="Center" Cursor="Hand" ToolTip="{DynamicResource View.Close}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseChip" Background="Transparent" CornerRadius="2">
                      <TextBlock Text="&#xE711;" FontFamily="{DynamicResource GlyphFont}" FontSize="9"
                                 Foreground="#5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="CloseChip" Property="Background" Value="#D0D0D0"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ViewTabSurface" Property="Background" Value="#F2F2F2"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ViewTabSurface" Property="Background" Value="White"/>
              <Setter TargetName="ViewTabSurface" Property="Margin" Value="0,0,2,-1"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dockable palette title strip ("Propiedades", "Navegador de proyectos"). -->
  <Style x:Key="PaletteHeaderBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="21"/>
  </Style>

  <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Margin" Value="4,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- Property grid: bold collapsible-looking group band, then label/value rows with hairlines. -->
  <Style x:Key="PropertySectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="Background" Value="{StaticResource PropertyGroupBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="4,4,4,4"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style x:Key="PropertyRowStyle" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="White" BorderBrush="{StaticResource PropertyGridLineBrush}" BorderThickness="0,0,0,1"
                  MinHeight="24">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44*"/>
                <ColumnDefinition Width="56*"/>
              </Grid.ColumnDefinitions>
              <Border BorderBrush="{StaticResource PropertyGridLineBrush}" BorderThickness="0,0,1,0">
                <TextBlock Text="{TemplateBinding Tag}" Margin="8,0,4,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Tag}"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="2,1" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Value cell editor: flat until focused, like an in-place grid editor. -->
  <Style x:Key="PropertyValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="MinHeight" Value="21"/>
    <Setter Property="Padding" Value="3,1"/>
  </Style>

  <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="8,6,8,2"/>
  </Style>

  <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ContextualButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="9,1"/>
    <Setter Property="Margin" Value="3,0"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="3,2"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
              <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="#7EB4EA"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Background" Value="#F4F4F4"/>
              <Setter Property="Foreground" Value="#8C8C8C"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Flat drop-down: white field, thin frame and a small chevron. -->
  <ControlTemplate x:Key="FlatComboBoxToggleTemplate" TargetType="ToggleButton">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1" SnapsToDevicePixels="True">
      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource GlyphFont}" FontSize="9" Foreground="#3C3C3C"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,6,0"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="#7EB4EA"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="4,2,22,2"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <ToggleButton x:Name="Toggle" Template="{StaticResource FlatComboBoxToggleTemplate}" Focusable="False"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="White"
                      BorderBrush="#828790" BorderThickness="1">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectionBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#A0A0A0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tree expander drawn as the classic boxed plus/minus. -->
  <Style x:Key="TreeExpanderToggleStyle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <Border Width="9" Height="9" BorderBrush="#919191" BorderThickness="1" Background="White"
                    SnapsToDevicePixels="True">
              <Grid>
                <Rectangle Width="5" Height="1" Fill="#3C3C3C"/>
                <Rectangle x:Name="Vertical" Width="1" Height="5" Fill="#3C3C3C"/>
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Padding" Value="2,1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpanderToggleStyle}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border x:Name="HeaderSurface" Grid.Column="1" Background="Transparent" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SelectionBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsSelectionActive" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource InactiveSelectionBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TreeView">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
  </Style>

  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{StaticResource RibbonBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
  </Style>
</ResourceDictionary>
