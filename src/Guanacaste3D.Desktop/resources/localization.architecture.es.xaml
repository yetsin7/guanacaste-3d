  <sys:String x:Key="Error.Invalid element style.">El estilo del elemento no es válido.</sys:String>
  <sys:String x:Key="Error.Invalid ramp, gutter, downspout, curtain wall or skylight geometry.">La geometría de la rampa, canal, bajante, muro cortina o tragaluz no es válida.</sys:String>
