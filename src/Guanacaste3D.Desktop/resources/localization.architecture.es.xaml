<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="Transaction.LoadArchitecturalLibrary">Cargar biblioteca arquitectónica</sys:String>
  <sys:String x:Key="Transaction.SetRoofShape">Cambiar forma de cubierta</sys:String>
  <sys:String x:Key="Transaction.SetColumnShape">Cambiar sección de columna</sys:String>
  <sys:String x:Key="Transaction.SetElementStyle">Cambiar estilo del elemento</sys:String>
