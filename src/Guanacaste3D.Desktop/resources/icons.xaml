<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Original Guanacaste 3D icon set. Each icon is a 24x24 stroke drawing sharing one pen,
    so the ribbon reads as a single family. No third-party or Autodesk artwork is used.
  -->
  <Pen x:Key="IconPen" Brush="#2B3A42" Thickness="1.6"
       StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
  <Pen x:Key="IconAccentPen" Brush="#007FA3" Thickness="1.6"
       StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
  <SolidColorBrush x:Key="IconAccentFill" Color="#CDE9F0"/>

  <!-- Wall: a running bond of brick courses. -->
  <DrawingImage x:Key="Icon.Wall">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M3,6 H21 V18 H3 Z M3,10 H21 M3,14 H21 M9,6 V10 M15,6 V10 M6,10 V14 M12,10 V14 M18,10 V14 M9,14 V18 M15,14 V18"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Door: a leaf and its swing arc. -->
  <DrawingImage x:Key="Icon.Door">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M7,21 V5 H12 V21"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M12,5 A12,12 0 0 1 20,19 M12,21 H20"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Window: frame with a mullion cross. -->
  <DrawingImage x:Key="Icon.Window">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M4,5 H20 V19 H4 Z M12,5 V19 M4,12 H20"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Opening types: stacked window swatches. -->
  <DrawingImage x:Key="Icon.OpeningTypes">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,8 H15 V19 H4 Z M9.5,8 V19 M4,13.5 H15"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M8,5 H20 V16"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Floor slab seen in slight perspective, with a grid. -->
  <DrawingImage x:Key="Icon.Floor">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M3,9 L12,5 L21,9 L12,13 Z M3,9 V13 L12,17 L21,13 V9 M12,13 V17"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Room: tagged area. -->
  <DrawingImage x:Key="Icon.Room">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,6 H20 V18 H4 Z"/>
        <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}"
          Geometry="M9,10 H15 V14 H9 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Level: datum line with a bubble head. -->
  <DrawingImage x:Key="Icon.Level">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,12 H16"/>
        <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}"
          Geometry="M16,12 A3,3 0 1 0 22,12 A3,3 0 1 0 16,12 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Levels: a stack of storeys. -->
  <DrawingImage x:Key="Icon.Levels">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,7 H20 M4,12 H20 M4,17 H20"/>
        <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}"
          Geometry="M18,5 A2,2 0 1 0 22,5 A2,2 0 1 0 18,5 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Apply type: a tag with a check. -->
  <DrawingImage x:Key="Icon.Apply">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,5 H13 L20,12 L13,19 H4 Z"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M7,12 L9.5,14.5 L14,9.5"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Sheet: a drawing with a title block. -->
  <DrawingImage x:Key="Icon.Sheet">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M5,4 H19 V20 H5 Z M14,20 V15 H19"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Open: a folder. -->
  <DrawingImage x:Key="Icon.Open">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M3,7 H10 L12,9 H21 V18 H3 Z"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Schedule: a data table. -->
  <DrawingImage x:Key="Icon.Schedule">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M4,5 H20 V19 H4 Z M4,9 H20 M4,14 H20 M11,9 V19"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Saved schedule: a table with a bookmark. -->
  <DrawingImage x:Key="Icon.Schedules">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,5 H16 V19 H4 Z M4,9 H16 M4,14 H16"/>
        <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}"
          Geometry="M17,4 H22 V13 L19.5,11 L17,13 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Plan: a floor plan outline. -->
  <DrawingImage x:Key="Icon.Plan">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M4,5 H20 V19 H4 Z M12,5 V12 M12,12 H20 M4,12 H8"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 3D model: an isometric cube. -->
  <DrawingImage x:Key="Icon.Cube">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M12,3 L21,8 V16 L12,21 L3,16 V8 Z M12,3 V12 M12,12 L21,8 M12,12 L3,8"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Elevation: a facade. -->
  <DrawingImage x:Key="Icon.Elevation">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,20 H20 M5,20 V8 L12,4 L19,8 V20"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M9,13 H12 V20 M14,12 H16 V15 H14 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Section: a cut line through a solid. -->
  <DrawingImage x:Key="Icon.Section">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M5,6 H14 V18 H5 Z"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M18,3 V21 M18,8 L14.5,11 M18,8 L21.5,11"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Sheets: a stack of drawings. -->
  <DrawingImage x:Key="Icon.Sheets">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M7,4 H18 V17 H7 Z M4,7 V20 H15"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Render: a sun with rays. -->
  <DrawingImage x:Key="Icon.Render">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}"
          Geometry="M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 Z"/>
        <GeometryDrawing Pen="{StaticResource IconPen}"
          Geometry="M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Fit: frame corners pointing out. -->
  <DrawingImage x:Key="Icon.Fit">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}"
        Geometry="M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16"/>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Export quantities: a table with an out-arrow. -->
  <DrawingImage x:Key="Icon.ExportTable">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,5 H14 V15 H4 Z M4,9 H14 M9,5 V15"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M12,19 H21 M18,16 L21,19 L18,22"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Export DXF: a drawing with an out-arrow. -->
  <DrawingImage x:Key="Icon.ExportDxf">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M5,4 H13 L17,8 V14 H5 Z M8,11 L11,8 L14,12"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M11,19 H21 M18,16 L21,19 L18,22"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Export IFC/3D: a cube with an out-arrow. -->
  <DrawingImage x:Key="Icon.ExportCube">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M9,3 L16,7 V13 L9,17 L2,13 V7 Z M9,3 V10 M9,10 L16,7 M9,10 L2,7"/>
        <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M13,20 H22 M19,17 L22,20 L19,23"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Parameters: sliders. -->
  <DrawingImage x:Key="Icon.Parameters">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,8 H20 M4,16 H20"/>
        <GeometryDrawing Brush="#FFFFFF" Pen="{StaticResource IconAccentPen}"
          Geometry="M8,8 A2.2,2.2 0 1 0 12.4,8 A2.2,2.2 0 1 0 8,8 Z M13,16 A2.2,2.2 0 1 0 17.4,16 A2.2,2.2 0 1 0 13,16 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Structure / steel -->
  <DrawingImage x:Key="Icon.Beam"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,6 H21 M3,18 H21 M12,6 V18"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Column"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M7,4 H17 M7,20 H17 M10,4 V20 M14,4 V20"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Connection"><DrawingImage.Drawing>
    <DrawingGroup>
      <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,8 H12 V16 H4 Z M12,10 H20 V14 H12 Z"/>
      <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}" Geometry="M7,11 A1,1 0 1 0 9,11 A1,1 0 1 0 7,11 Z"/>
    </DrawingGroup>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Rebar"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,18 V9 A2,2 0 0 1 8,9 M8,9 H18 M14,5 L18,9 L14,13"/>
  </DrawingImage.Drawing></DrawingImage>

  <!-- MEP -->
  <DrawingImage x:Key="Icon.Duct"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,9 H15 V17 H3 Z M15,9 L21,5 M15,17 L21,13 M21,5 V13"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Pipe"><DrawingImage.Drawing>
    <DrawingGroup>
      <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M7,7 H19 M7,17 H19"/>
      <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M5,7 A2,5 0 0 0 5,17 M19,7 A2,5 0 0 1 19,17"/>
    </DrawingGroup>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Wire"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,16 L7,8 L11,16 L15,8 L19,16 L21,12"/>
  </DrawingImage.Drawing></DrawingImage>

  <!-- Annotation -->
  <DrawingImage x:Key="Icon.Dimension"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,7 V17 M20,7 V17 M4,12 H20 M4,12 L7,9 M4,12 L7,15 M20,12 L17,9 M20,12 L17,15"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Text"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M6,6 H18 M12,6 V18 M9,18 H15"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Tag"><DrawingImage.Drawing>
    <DrawingGroup>
      <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,7 H13 L20,12 L13,17 H3 Z"/>
      <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}" Geometry="M6,10.5 A1.5,1.5 0 1 0 9,10.5 A1.5,1.5 0 1 0 6,10.5 Z"/>
    </DrawingGroup>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Material"><DrawingImage.Drawing>
    <DrawingGroup>
      <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconPen}" Geometry="M5,12 A7,7 0 1 0 19,12 A7,7 0 1 0 5,12 Z"/>
      <GeometryDrawing Pen="{StaticResource IconAccentPen}" Geometry="M9,9 A3,3 0 0 0 8,12"/>
    </DrawingGroup>
  </DrawingImage.Drawing></DrawingImage>

  <!-- Modify / transform -->
  <DrawingImage x:Key="Icon.Move"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M12,3 V21 M3,12 H21 M12,3 L9,6 M12,3 L15,6 M12,21 L9,18 M12,21 L15,18 M3,12 L6,9 M3,12 L6,15 M21,12 L18,9 M21,12 L18,15"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Paste"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M6,6 H18 V21 H6 Z M9,6 V4 H15 V6 M9,11 H15 M9,15 H15"/>
  </DrawingImage.Drawing></DrawingImage>

  <!-- Mass &amp; site -->
  <DrawingImage x:Key="Icon.Mass"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,19 H20 L12,4 Z M8,19 L12,11 L16,19"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Site"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,16 Q9,10 12,13 T21,11 M3,20 Q9,15 12,17 T21,16"/>
  </DrawingImage.Drawing></DrawingImage>

  <!-- Insert / manage -->
  <DrawingImage x:Key="Icon.Link"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M9,15 L15,9 M7,13 A3,3 0 0 1 11,9 L13,7 A3,3 0 0 1 17,11 L15,13 M9,11 L7,13 A3,3 0 0 0 11,17 L13,15"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Import"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M12,3 V13 M8,9 L12,13 L16,9 M4,16 H20 V20 H4 Z"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Family"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,4 H20 V20 H4 Z M9,9 H15 V15 H9 Z M12,4 V9 M12,15 V20 M4,12 H9 M15,12 H20"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Phase"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,7 H14 V17 H4 Z M8,7 V4 H18 V14 H14"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Dynamo"><DrawingImage.Drawing>
    <DrawingGroup>
      <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M7,7 L17,7 M17,7 L12,17 M12,17 L7,7"/>
      <GeometryDrawing Brush="{StaticResource IconAccentFill}" Pen="{StaticResource IconAccentPen}" Geometry="M5,7 A2,2 0 1 0 9,7 A2,2 0 1 0 5,7 Z M15,7 A2,2 0 1 0 19,7 A2,2 0 1 0 15,7 Z M10,17 A2,2 0 1 0 14,17 A2,2 0 1 0 10,17 Z"/>
    </DrawingGroup>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Analysis"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M3,20 H21 M6,20 V13 M11,20 V8 M16,20 V11 M20,20 V5"/>
  </DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="Icon.Grid"><DrawingImage.Drawing>
    <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M4,4 H20 V20 H4 Z M4,12 H20 M12,4 V20"/>
  </DrawingImage.Drawing></DrawingImage>
</ResourceDictionary>
