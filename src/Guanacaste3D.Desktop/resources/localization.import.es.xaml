<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Spanish text for the model importers (OBJ, DXF, DWG, STL, IFC, SketchUp, Revit). Validation messages are keyed
       by "Error." + the English message, as everywhere else. -->
  <sys:String x:Key="Error.The model file does not exist.">El archivo del modelo no existe.</sys:String>
  <sys:String x:Key="Error.The model file is empty.">El archivo del modelo está vacío.</sys:String>
  <sys:String x:Key="Error.The model file contains no geometry.">El archivo no contiene geometría que se pueda mostrar.</sys:String>
  <sys:String x:Key="Error.The model file is too large to import.">El archivo del modelo es demasiado grande para importarlo.</sys:String>
  <sys:String x:Key="Error.The model file format is not supported.">El formato del archivo no es compatible.</sys:String>
  <sys:String x:Key="Error.The file is not a Revit file.">El archivo no es un archivo de Revit válido.</sys:String>
  <sys:String x:Key="Error.Revit keeps its geometry in a proprietary format; export the model to IFC from Revit and import that file.">Revit guarda su geometría en un formato propietario. Exporta el modelo a IFC desde Revit (Archivo → Exportar → IFC) e importa ese archivo.</sys:String>
  <sys:String x:Key="Error.AutoCAD DWG files need AutoCAD or the ODA File Converter, which were not found on this computer.">Los archivos DWG necesitan AutoCAD o el ODA File Converter, y no se encontraron en este equipo. Guarda el dibujo como DXF e impórtalo.</sys:String>
  <sys:String x:Key="Error.The DWG conversion did not produce a drawing.">La conversión del DWG no produjo ningún dibujo.</sys:String>
  <sys:String x:Key="Error.The DWG conversion timed out.">La conversión del DWG tardó demasiado y se canceló.</sys:String>
  <sys:String x:Key="Error.Binary DXF files are not supported; save the drawing as ASCII DXF.">Los DXF binarios no son compatibles. Guarda el dibujo como DXF ASCII.</sys:String>
  <sys:String x:Key="Error.The DXF file is not valid.">El archivo DXF no es válido.</sys:String>
  <sys:String x:Key="Error.SketchUp files need the SketchUp SDK library, which was not found on this computer.">Los archivos de SketchUp necesitan la biblioteca SketchUp SDK, que no se encontró en este equipo. Exporta el modelo desde SketchUp a OBJ o COLLADA (DAE).</sys:String>
  <sys:String x:Key="Error.The SketchUp file could not be read.">No se pudo leer el archivo de SketchUp (puede ser más reciente que la biblioteca instalada).</sys:String>
  <sys:String x:Key="Error.The IFC file is not valid.">El archivo IFC no es válido.</sys:String>
  <sys:String x:Key="Error.The glTF file is not valid.">El archivo glTF no es válido.</sys:String>
  <sys:String x:Key="Error.The COLLADA file is not valid.">El archivo COLLADA no es válido.</sys:String>
  <sys:String x:Key="Error.The model links file is not valid.">El archivo de vínculos de modelos no es válido.</sys:String>
  <!-- Revit projects opened as editable Guanacaste projects through the Revit bridge add-in. -->
  <sys:String x:Key="RevitImport.Title">Abrir proyecto de Revit</sys:String>
  <sys:String x:Key="RevitImport.Intro">Guanacaste 3D abrirá este proyecto con tu Revit {0}, leerá cada muro, puerta, ventana, losa, techo, mueble y equipo, y lo convertirá en un proyecto editable: muros, aberturas y losas nativos, y el resto como familias .g3df.</sys:String>
  <sys:String x:Key="RevitImport.IntroExchange">Este archivo de intercambio (.g3dx) se convertirá en un proyecto editable: muros, aberturas y losas nativos, y el resto como familias .g3df.</sys:String>
  <sys:String x:Key="RevitImport.NoRevit">No se encontró Revit 2025 o posterior en este equipo. Exporta el modelo desde Revit con el botón «Exportar a Guanacaste 3D» (archivo .g3dx) o a IFC, e importa ese archivo.</sys:String>
  <sys:String x:Key="RevitImport.FirstRun">La primera vez, Revit pregunta si confías en el complemento «Guanacaste 3D»: elige «Cargar siempre». Revit se abrirá y se cerrará solo al terminar.</sys:String>
  <sys:String x:Key="RevitImport.Cached">Este proyecto ya se leyó antes y no ha cambiado: se abrirá de inmediato.</sys:String>
  <sys:String x:Key="RevitImport.SaveFamilies">Guardar también cada familia como archivo .g3df en una carpeta junto al modelo</sys:String>
  <sys:String x:Key="RevitImport.Start">Convertir y abrir</sys:String>
  <sys:String x:Key="RevitImport.Open">Abrir proyecto</sys:String>
  <sys:String x:Key="RevitImport.Stage.starting">Iniciando Revit…</sys:String>
  <sys:String x:Key="RevitImport.Stage.opening">Revit está abriendo el proyecto (puede tardar si viene de una versión anterior)…</sys:String>
  <sys:String x:Key="RevitImport.Stage.exporting">Leyendo los elementos del modelo… {0:P0}</sys:String>
  <sys:String x:Key="RevitImport.Stage.converting">Convirtiendo a elementos de Guanacaste 3D…</sys:String>
  <sys:String x:Key="RevitImport.Stage.families">Guardando las familias .g3df…</sys:String>
  <sys:String x:Key="RevitImport.Cancelled">Conversión cancelada; Revit se cerró.</sys:String>
  <sys:String x:Key="RevitImport.Done">Conversión terminada en {0:0} s.</sys:String>
  <sys:String x:Key="RevitImport.Report.Native">{0} niveles · {1} muros ({2} tipos) · {3} puertas · {4} ventanas ({5} tipos) · {6} losas · {7} cielos · {8} techos planos · {9} habitaciones</sys:String>
  <sys:String x:Key="RevitImport.Report.Families">{0} elementos como {1} familias .g3df ({2:N0} triángulos)</sys:String>
  <sys:String x:Key="RevitImport.Report.Fallback">Conservados con la geometría de Revit:</sys:String>
  <sys:String x:Key="RevitImport.Report.Skipped">Omitidos:</sys:String>
  <sys:String x:Key="RevitImport.Report.FamiliesSaved">Familias guardadas en {0}</sys:String>
  <sys:String x:Key="RevitImport.Status">Proyecto de Revit convertido: {0} muros, {1} aberturas, {2} familias.</sys:String>
  <sys:String x:Key="RevitImport.Reason.Curtain wall">muro cortina</sys:String>
  <sys:String x:Key="RevitImport.Reason.Stacked wall">muro apilado</sys:String>
  <sys:String x:Key="RevitImport.Reason.Curved wall">muro curvo</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall without location">muro sin línea de ubicación</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall with edited profile">muro con perfil editado</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall attached to a roof or floor">muro enlazado a techo o losa</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall thickness out of range">muro con espesor fuera de rango</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall base between levels">muro con desfase de base</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall with openings that do not fit">muro con huecos que no caben</sys:String>
  <sys:String x:Key="RevitImport.Reason.Wall too short">muro demasiado corto</sys:String>
  <sys:String x:Key="RevitImport.Reason.Opening in a modeled wall">puerta o ventana en muro modelado</sys:String>
  <sys:String x:Key="RevitImport.Reason.Opening without wall">puerta o ventana sin muro anfitrión</sys:String>
  <sys:String x:Key="RevitImport.Reason.Sloped roof">techo inclinado</sys:String>
  <sys:String x:Key="RevitImport.Reason.Sloped or shaped slab">losa inclinada o con forma</sys:String>
  <sys:String x:Key="RevitImport.Reason.Slab without outline">losa sin contorno</sys:String>
  <sys:String x:Key="RevitImport.Reason.Slab with shaped openings">losa con huecos irregulares</sys:String>
  <sys:String x:Key="RevitImport.Reason.Slab outline too complex">losa con contorno muy complejo</sys:String>
  <sys:String x:Key="RevitImport.Reason.Element without geometry">elemento sin geometría</sys:String>
  <sys:String x:Key="RevitImport.Reason.Flat or empty geometry">geometría plana o vacía</sys:String>
  <sys:String x:Key="RevitImport.Reason.Element larger than 50 m">elemento de más de 50 m</sys:String>
  <sys:String x:Key="RevitImport.Reason.Room with several boundaries">habitación con varios contornos</sys:String>
  <sys:String x:Key="RevitImport.Reason.Room that is not rectangular">habitación no rectangular</sys:String>
  <sys:String x:Key="Error.Revit is not installed on this computer; export the model to IFC or .g3dx from Revit and import that file.">Revit no está instalado en este equipo; exporta el modelo desde Revit a IFC o .g3dx e importa ese archivo.</sys:String>
  <sys:String x:Key="Error.The project was saved by a newer Revit than the one installed on this computer.">El proyecto se guardó con un Revit más nuevo que el instalado en este equipo.</sys:String>
  <sys:String x:Key="Error.Revit did not finish exporting the project in time.">Revit no terminó de exportar el proyecto a tiempo.</sys:String>
  <sys:String x:Key="Error.Revit closed before exporting the project.">Revit se cerró antes de exportar el proyecto. Si apareció el aviso del complemento sin firma, elige «Cargar siempre» e inténtalo de nuevo.</sys:String>
  <sys:String x:Key="Error.Revit could not be started.">No se pudo iniciar Revit.</sys:String>
  <sys:String x:Key="Error.The exchange file is damaged.">El archivo de intercambio está dañado.</sys:String>
  <sys:String x:Key="Error.The file is not a supported Guanacaste exchange file.">El archivo no es un intercambio de Guanacaste compatible.</sys:String>
  <sys:String x:Key="Error.An exchange mesh is damaged.">Una malla del archivo de intercambio está dañada.</sys:String>
</ResourceDictionary>
