<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Spanish text for the model importers (OBJ, DXF, DWG, STL, IFC, SketchUp, Revit). Validation messages are keyed
       by "Error." + the English message, as everywhere else. -->
  <sys:String x:Key="Error.The model file does not exist.">El archivo del modelo no existe.</sys:String>
  <sys:String x:Key="Error.The model file is empty.">El archivo del modelo está vacío.</sys:String>
  <sys:String x:Key="Error.The model file contains no geometry.">El archivo no contiene geometría que se pueda mostrar.</sys:String>
  <sys:String x:Key="Error.The model file is too large to import.">El archivo del modelo es demasiado grande para importarlo.</sys:String>
  <sys:String x:Key="Error.The model file format is not supported.">El formato del archivo no es compatible.</sys:String>
  <sys:String x:Key="Error.The file is not a Revit file.">El archivo no es un archivo de Revit válido.</sys:String>
  <sys:String x:Key="Error.Revit keeps its geometry in a proprietary format; export the model to IFC from Revit and import that file.">Revit guarda su geometría en un formato propietario. Exporta el modelo a IFC desde Revit (Archivo → Exportar → IFC) e importa ese archivo.</sys:String>
  <sys:String x:Key="Error.AutoCAD DWG files need AutoCAD or the ODA File Converter, which were not found on this computer.">Los archivos DWG necesitan AutoCAD o el ODA File Converter, y no se encontraron en este equipo. Guarda el dibujo como DXF e impórtalo.</sys:String>
  <sys:String x:Key="Error.The DWG conversion did not produce a drawing.">La conversión del DWG no produjo ningún dibujo.</sys:String>
  <sys:String x:Key="Error.The DWG conversion timed out.">La conversión del DWG tardó demasiado y se canceló.</sys:String>
  <sys:String x:Key="Error.Binary DXF files are not supported; save the drawing as ASCII DXF.">Los DXF binarios no son compatibles. Guarda el dibujo como DXF ASCII.</sys:String>
  <sys:String x:Key="Error.The DXF file is not valid.">El archivo DXF no es válido.</sys:String>
  <sys:String x:Key="Error.SketchUp files need the SketchUp SDK library, which was not found on this computer.">Los archivos de SketchUp necesitan la biblioteca SketchUp SDK, que no se encontró en este equipo. Exporta el modelo desde SketchUp a OBJ o COLLADA (DAE).</sys:String>
  <sys:String x:Key="Error.The SketchUp file could not be read.">No se pudo leer el archivo de SketchUp (puede ser más reciente que la biblioteca instalada).</sys:String>
  <sys:String x:Key="Error.The IFC file is not valid.">El archivo IFC no es válido.</sys:String>
  <sys:String x:Key="Error.The glTF file is not valid.">El archivo glTF no es válido.</sys:String>
  <sys:String x:Key="Error.The COLLADA file is not valid.">El archivo COLLADA no es válido.</sys:String>
  <sys:String x:Key="Error.The model links file is not valid.">El archivo de vínculos de modelos no es válido.</sys:String>
</ResourceDictionary>
