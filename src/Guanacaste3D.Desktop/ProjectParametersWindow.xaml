<Window x:Class="Guanacaste3D.Desktop.ProjectParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Parameters.WindowTitle}" Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Parameters.Close}" Click="Close_Click" MinWidth="90" IsCancel="True"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Parameters.DefinitionsHeader}" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource Parameters.Name}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox" MaxLength="80"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Parameters.Spec}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                <ComboBox x:Name="SpecBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Parameters.Binding}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                <ComboBox x:Name="BindingBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource Parameters.Group}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
            <TextBox x:Name="GroupBox" MaxLength="80"/>
            <TextBlock Text="{DynamicResource Parameters.Description}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
            <TextBox x:Name="DescriptionBox" MaxLength="1000" Height="44" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{DynamicResource Parameters.Formula}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
            <TextBox x:Name="FormulaBox" MaxLength="2000" FontFamily="Consolas" TextChanged="FormulaBox_TextChanged"/>
            <TextBlock x:Name="FormulaHelp" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{DynamicResource Parameters.Categories}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/>
            <WrapPanel x:Name="CategoryPanel"/>
            <UniformGrid Columns="3" Margin="0,8,0,0">
              <Button Content="{DynamicResource Parameters.New}" Click="NewDefinition_Click" Margin="0,0,4,0"/>
              <Button Content="{DynamicResource Parameters.Apply}" Click="ApplyDefinition_Click" Margin="2,0"/>
              <Button Content="{DynamicResource Parameters.Delete}" Click="DeleteDefinition_Click" Margin="4,0,0,0"/>
            </UniformGrid>
          </StackPanel>
          <ListBox x:Name="DefinitionsList" SelectionChanged="DefinitionsList_SelectionChanged"
                   BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Parameters.ScheduleHeader}" Style="{StaticResource PanelHeaderStyle}" VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryBox" Width="170" Margin="12,0,0,0" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectionChanged="CategoryBox_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="UndoButton" Content="{DynamicResource Action.Undo}" Click="Undo_Click" MinWidth="80" Margin="0,0,4,0"/>
              <Button x:Name="RedoButton" Content="{DynamicResource Action.Redo}" Click="Redo_Click" MinWidth="80" Margin="0,0,10,0"/>
              <Button Content="{DynamicResource Parameters.ExportCsv}" Click="ExportCsv_Click" MinWidth="110"/>
            </StackPanel>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Parameters.ScheduleHint}" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>
          <DataGrid x:Name="ScheduleGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    SelectionUnit="Cell" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    CellEditEnding="ScheduleGrid_CellEditEnding" PreviewKeyDown="ScheduleGrid_PreviewKeyDown"
                    RowHeight="24" BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
