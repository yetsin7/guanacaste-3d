<UserControl x:Class="Guanacaste3D.Desktop.Controls.RenderPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource CanvasBrush}" Focusable="False">
  <UserControl.Resources>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="PanelLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,7,0,3"/>
    </Style>
    <Style x:Key="PanelCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="PanelButton" TargetType="Button">
      <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="8,0,8,8"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0" Background="{DynamicResource PanelBrush}">
      <Border DockPanel.Dock="Top" Style="{StaticResource PaletteHeaderBorderStyle}">
        <TextBlock Text="{DynamicResource View.Render}" Style="{StaticResource PanelHeaderStyle}"/>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,8,0,4">
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <ToggleButton x:Name="PreviewToggle" IsChecked="True" Padding="10,6"
                            Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed"
                            Content="{DynamicResource RenderPanel.Preview}" ToolTip="{DynamicResource RenderPanel.PreviewHint}"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="RenderButton" Content="{DynamicResource RenderPanel.Render}" Click="RenderButton_Click"
                        Padding="12,8" FontWeight="SemiBold" Background="{DynamicResource AccentBrush}"
                        Foreground="White" BorderBrush="{DynamicResource AccentBrush}"/>
                <Button x:Name="PauseButton" Grid.Column="1" Content="{DynamicResource RenderPanel.Pause}"
                        Click="PauseButton_Click" Padding="10,8" Margin="6,0,0,0" IsEnabled="False"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Scene}"/>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Scenario}" Margin="0,0,0,3"/>
              <ComboBox x:Name="ScenarioPicker" SelectedIndex="0" SelectionChanged="Lighting_Changed">
                <ComboBoxItem Content="{DynamicResource RenderPanel.Sunny}" Tag="Sunny"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.Overcast}" Tag="Overcast"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.GoldenHour}" Tag="GoldenHour"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.Dusk}" Tag="Dusk"/>
              </ComboBox>
              <Grid x:Name="SunControls"><StackPanel>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Date}"/>
                <DatePicker x:Name="SunDatePicker" SelectedDateFormat="Short" SelectedDateChanged="Lighting_Changed"/>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Hour}"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Width="44" Foreground="{DynamicResource PrimaryTextBrush}"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding Value, ElementName=HourSlider, StringFormat={}{0:0.0} h}"/>
                  <Slider x:Name="HourSlider" Minimum="5" Maximum="19" Value="10" TickFrequency="0.25"
                          IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                </DockPanel>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Clouds}"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Width="44" Foreground="{DynamicResource PrimaryTextBrush}"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding Value, ElementName=CloudSlider, StringFormat={}{0:0} %}"/>
                  <Slider x:Name="CloudSlider" Minimum="0" Maximum="100" Value="30" TickFrequency="5"
                          IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"
                          ToolTip="{DynamicResource RenderPanel.CloudsHint}"/>
                </DockPanel>
              </StackPanel></Grid>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Latitude}"/>
              <TextBox x:Name="LatitudeInput" Text="12.1" Width="70" HorizontalAlignment="Left"
                       TextChanged="Latitude_Changed" ToolTip="{DynamicResource RenderPanel.LatitudeHint}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Quality}"/>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.QualityLabel}" Margin="0,0,0,3"/>
              <ComboBox x:Name="QualityPicker" SelectedIndex="1" SelectionChanged="Quality_Changed">
                <ComboBoxItem Content="{DynamicResource RenderPanel.Draft}" Tag="Draft"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.Standard}" Tag="Standard"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.High}" Tag="High"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.Final}" Tag="Final"/>
              </ComboBox>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Size}"/>
              <ComboBox x:Name="SizePicker" SelectedIndex="0" SelectionChanged="Quality_Changed">
                <ComboBoxItem Content="{DynamicResource RenderPanel.SizeView}" Tag="0x0"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.SizeHd}" Tag="1280x720"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.SizeFullHd}" Tag="1920x1080"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.SizeQhd}" Tag="2560x1440"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.SizeUhd}" Tag="3840x2160"/>
              </ComboBox>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Resources}"/>
              <ComboBox x:Name="ResourcePicker" SelectedIndex="1" SelectionChanged="Quality_Changed">
                <ComboBoxItem Content="{DynamicResource RenderPanel.Eco}" Tag="Eco"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.Balanced}" Tag="Balanced"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.Maximum}" Tag="Maximum"/>
              </ComboBox>
              <TextBlock x:Name="MemoryText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5"
                         Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Image}"/>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Exposure}" Margin="0,0,0,3"/>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="48" Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" TextAlignment="Right"
                           Text="{Binding Value, ElementName=ExposureSlider, StringFormat={}{0:+0.0;-0.0;0.0} EV}"/>
                <Slider x:Name="ExposureSlider" Minimum="-3" Maximum="3" Value="0" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
              </DockPanel>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Look}"/>
              <ComboBox x:Name="LookPicker" SelectedIndex="0" SelectionChanged="Look_Changed">
                <ComboBoxItem Content="{DynamicResource RenderPanel.LookPhotographic}" Tag="AgX"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.LookContrast}" Tag="Aces"/>
                <ComboBoxItem Content="{DynamicResource RenderPanel.LookSoft}" Tag="Soft"/>
              </ComboBox>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Temperature}"/>
              <DockPanel>
                <TextBlock x:Name="TemperatureText" DockPanel.Dock="Right" Width="48" Text="5500 K"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                <Slider x:Name="TemperatureSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" ValueChanged="Temperature_Changed"
                        ToolTip="{DynamicResource RenderPanel.TemperatureHint}"/>
              </DockPanel>
              <CheckBox x:Name="HazeCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                        Content="{DynamicResource RenderPanel.Haze}" Checked="Haze_Changed" Unchecked="Haze_Changed"/>
              <CheckBox x:Name="AutoExposureCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                        Content="{DynamicResource RenderPanel.AutoExposure}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
              <CheckBox x:Name="BloomCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                        Content="{DynamicResource RenderPanel.Bloom}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
              <CheckBox x:Name="VignetteCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                        Content="{DynamicResource RenderPanel.Vignette}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
              <CheckBox x:Name="VerticalsCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                        Content="{DynamicResource RenderPanel.Verticals}" Checked="Camera_Changed" Unchecked="Camera_Changed"/>
              <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.DepthOfField}"/>
              <Slider x:Name="DepthOfFieldSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                      IsSnapToTickEnabled="True" ValueChanged="Camera_SliderChanged"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Navigation}"/>
              <CheckBox x:Name="CollisionCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0"
                        Content="{DynamicResource RenderPanel.Collisions}" ToolTip="{DynamicResource RenderPanel.CollisionsHint}"
                        Checked="Collision_Changed" Unchecked="Collision_Changed"/>
              <Button Content="{DynamicResource RenderPanel.FrameAll}" Click="FrameAll_Click"
                      Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <Expander Header="{DynamicResource RenderPanel.Tour}" Foreground="{DynamicResource PrimaryTextBrush}"
                        FontWeight="SemiBold" Margin="0,12,0,0" IsExpanded="False">
                <StackPanel Margin="0,7,0,0">
                  <TextBlock Text="{DynamicResource RenderPanel.TourHint}" Foreground="{DynamicResource SecondaryTextBrush}"
                             FontWeight="Normal" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ListBox x:Name="MarksList" Height="110" SelectionChanged="MarksList_SelectionChanged"/>
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="{DynamicResource RenderPanel.AddMark}" Click="AddMark_Click" Style="{StaticResource PanelButton}"/>
                    <Button x:Name="GoToMarkButton" Content="{DynamicResource RenderPanel.GoToMark}" Click="GoToMark_Click"
                            Style="{StaticResource PanelButton}" IsEnabled="False"/>
                    <Button x:Name="RemoveMarkButton" Content="{DynamicResource RenderPanel.RemoveMark}" Click="RemoveMark_Click"
                            Style="{StaticResource PanelButton}" IsEnabled="False"/>
                  </WrapPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.MarkSeconds}"/>
                  <TextBox x:Name="MarkSecondsInput" Text="4" Width="60" HorizontalAlignment="Left" LostFocus="MarkSeconds_LostFocus"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Fps}"/>
                  <ComboBox x:Name="FpsPicker" SelectedIndex="1" Width="80" HorizontalAlignment="Left">
                    <ComboBoxItem Content="24" Tag="24"/><ComboBoxItem Content="30" Tag="30"/><ComboBoxItem Content="60" Tag="60"/>
                  </ComboBox>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="PlayTourButton" Content="{DynamicResource RenderPanel.PlayTour}" Click="PlayTour_Click"
                            Style="{StaticResource PanelButton}"/>
                    <Button x:Name="RenderTourButton" Content="{DynamicResource RenderPanel.RenderVideo}" Click="RenderTour_Click"
                            Style="{StaticResource PanelButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Output}"/>
              <WrapPanel>
                <Button x:Name="SaveButton" Content="{DynamicResource RenderPanel.SaveImage}" Click="SaveButton_Click"
                        Style="{StaticResource PanelButton}" IsEnabled="False"/>
                <Button x:Name="CopyButton" Content="{DynamicResource RenderPanel.CopyImage}" Click="CopyButton_Click"
                        Style="{StaticResource PanelButton}" IsEnabled="False"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}"/>
    <Grid Grid.Column="2" x:Name="ImageHost" ClipToBounds="True" SizeChanged="ImageHost_SizeChanged">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F8FAFC" Offset="0"/><GradientStop Color="#E9EEF3" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Border Margin="22,18,22,50" Background="White" BorderBrush="#D2D9E0" BorderThickness="1" CornerRadius="4" Padding="6">
        <Border.Effect><DropShadowEffect Color="#64748B" BlurRadius="16" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False"/>
      </Border>
      <TextBlock x:Name="HintText" Text="{DynamicResource RenderPanel.Controls}"
                 Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="30,0,30,57"
                 VerticalAlignment="Bottom" TextWrapping="Wrap" IsHitTestVisible="False"/>
      <Border VerticalAlignment="Bottom" Background="#F8FAFC" BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="0,1,0,0" Padding="14,9">
        <DockPanel>
          <ProgressBar x:Name="RenderProgress" DockPanel.Dock="Right" Width="170" Height="8" Minimum="0" Maximum="1"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{DynamicResource RenderPanel.Idle}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
