<UserControl x:Class="Guanacaste3D.Desktop.Controls.RenderPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="#1D1D1F" Focusable="False">
  <UserControl.Resources>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
    <Style x:Key="PanelLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C7C7CC"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style x:Key="PanelCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E5E5EA"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="PanelButton" TargetType="Button">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="318"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Controls column -->
    <Border Grid.Column="0" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
          <ToggleButton x:Name="PreviewToggle" IsChecked="True" Padding="10,6" Checked="PreviewToggle_Changed"
                        Unchecked="PreviewToggle_Changed" Content="{DynamicResource RenderPanel.Preview}"
                        ToolTip="{DynamicResource RenderPanel.PreviewHint}"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="RenderButton" Grid.Column="0" Content="{DynamicResource RenderPanel.Render}" Click="RenderButton_Click"
                    Padding="12,8" FontWeight="SemiBold" Background="#0A84FF" Foreground="White" BorderBrush="#0A84FF"/>
            <Button x:Name="PauseButton" Grid.Column="1" Content="{DynamicResource RenderPanel.Pause}" Click="PauseButton_Click"
                    Padding="10,8" Margin="6,0,0,0" IsEnabled="False"/>
          </Grid>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14,6,14,12">
          <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Output}" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SaveButton" Content="{DynamicResource RenderPanel.SaveImage}" Click="SaveButton_Click"
                    Style="{StaticResource PanelButton}" IsEnabled="False"/>
            <Button x:Name="CopyButton" Content="{DynamicResource RenderPanel.CopyImage}" Click="CopyButton_Click"
                    Style="{StaticResource PanelButton}" IsEnabled="False"/>
          </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14,0,14,10">
            <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Scene}"/>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Scenario}"/>
            <ComboBox x:Name="ScenarioPicker" SelectedIndex="0" SelectionChanged="Lighting_Changed">
              <ComboBoxItem Content="{DynamicResource RenderPanel.Sunny}" Tag="Sunny"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.Overcast}" Tag="Overcast"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.GoldenHour}" Tag="GoldenHour"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.Dusk}" Tag="Dusk"/>
            </ComboBox>
            <Grid x:Name="SunControls">
              <StackPanel>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Date}"/>
                <DatePicker x:Name="SunDatePicker" SelectedDateFormat="Short" SelectedDateChanged="Lighting_Changed"/>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Hour}"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Width="44" Foreground="#E5E5EA" VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding Value, ElementName=HourSlider, StringFormat={}{0:0.0} h}"/>
                  <Slider x:Name="HourSlider" Minimum="5" Maximum="19" Value="10" TickFrequency="0.25" IsSnapToTickEnabled="True"
                          ValueChanged="Lighting_SliderChanged"/>
                </DockPanel>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Latitude}"/>
            <TextBox x:Name="LatitudeInput" Text="12.1" Width="70" HorizontalAlignment="Left" TextChanged="Latitude_Changed"
                     ToolTip="{DynamicResource RenderPanel.LatitudeHint}"/>

            <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Quality}"/>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.QualityLabel}"/>
            <ComboBox x:Name="QualityPicker" SelectedIndex="1" SelectionChanged="Quality_Changed">
              <ComboBoxItem Content="{DynamicResource RenderPanel.Draft}" Tag="Draft"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.Standard}" Tag="Standard"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.High}" Tag="High"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.Final}" Tag="Final"/>
            </ComboBox>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Size}"/>
            <ComboBox x:Name="SizePicker" SelectedIndex="0" SelectionChanged="Quality_Changed">
              <ComboBoxItem Content="{DynamicResource RenderPanel.SizeView}" Tag="0x0"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.SizeHd}" Tag="1280x720"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.SizeFullHd}" Tag="1920x1080"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.SizeQhd}" Tag="2560x1440"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.SizeUhd}" Tag="3840x2160"/>
            </ComboBox>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Resources}"/>
            <ComboBox x:Name="ResourcePicker" SelectedIndex="1" SelectionChanged="Quality_Changed">
              <ComboBoxItem Content="{DynamicResource RenderPanel.Eco}" Tag="Eco"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.Balanced}" Tag="Balanced"/>
              <ComboBoxItem Content="{DynamicResource RenderPanel.Maximum}" Tag="Maximum"/>
            </ComboBox>
            <TextBlock x:Name="MemoryText" Foreground="#8E8E93" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Image}"/>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Exposure}"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Width="48" Foreground="#E5E5EA" VerticalAlignment="Center" TextAlignment="Right"
                         Text="{Binding Value, ElementName=ExposureSlider, StringFormat={}{0:+0.0;-0.0;0.0} EV}"/>
              <Slider x:Name="ExposureSlider" Minimum="-3" Maximum="3" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                      ValueChanged="Finish_SliderChanged"/>
            </DockPanel>
            <CheckBox x:Name="AutoExposureCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                      Content="{DynamicResource RenderPanel.AutoExposure}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
            <CheckBox x:Name="BloomCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                      Content="{DynamicResource RenderPanel.Bloom}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
            <CheckBox x:Name="VignetteCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                      Content="{DynamicResource RenderPanel.Vignette}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
            <CheckBox x:Name="VerticalsCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                      Content="{DynamicResource RenderPanel.Verticals}" Checked="Camera_Changed" Unchecked="Camera_Changed"/>
            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.DepthOfField}"/>
            <Slider x:Name="DepthOfFieldSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="Camera_SliderChanged"/>

            <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Navigation}"/>
            <CheckBox x:Name="CollisionCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                      Content="{DynamicResource RenderPanel.Collisions}" ToolTip="{DynamicResource RenderPanel.CollisionsHint}"
                      Checked="Collision_Changed" Unchecked="Collision_Changed"/>
            <Button Content="{DynamicResource RenderPanel.FrameAll}" Click="FrameAll_Click" Style="{StaticResource PanelButton}"
                    HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <Expander Header="{DynamicResource RenderPanel.Tour}" Foreground="#F2F2F7" FontWeight="SemiBold" Margin="0,14,0,0"
                      IsExpanded="False">
              <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{DynamicResource RenderPanel.TourHint}" Foreground="#AEAEB2" FontWeight="Normal" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ListBox x:Name="MarksList" Height="110" SelectionChanged="MarksList_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="{DynamicResource RenderPanel.AddMark}" Click="AddMark_Click" Style="{StaticResource PanelButton}"/>
                  <Button x:Name="GoToMarkButton" Content="{DynamicResource RenderPanel.GoToMark}" Click="GoToMark_Click"
                          Style="{StaticResource PanelButton}" IsEnabled="False"/>
                  <Button x:Name="RemoveMarkButton" Content="{DynamicResource RenderPanel.RemoveMark}" Click="RemoveMark_Click"
                          Style="{StaticResource PanelButton}" IsEnabled="False"/>
                </StackPanel>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.MarkSeconds}" FontWeight="Normal"/>
                <TextBox x:Name="MarkSecondsInput" Text="4" Width="60" HorizontalAlignment="Left" LostFocus="MarkSeconds_LostFocus"/>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Fps}" FontWeight="Normal"/>
                <ComboBox x:Name="FpsPicker" SelectedIndex="1" Width="80" HorizontalAlignment="Left">
                  <ComboBoxItem Content="24" Tag="24"/>
                  <ComboBoxItem Content="30" Tag="30"/>
                  <ComboBoxItem Content="60" Tag="60"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="PlayTourButton" Content="{DynamicResource RenderPanel.PlayTour}" Click="PlayTour_Click"
                          Style="{StaticResource PanelButton}"/>
                  <Button x:Name="RenderTourButton" Content="{DynamicResource RenderPanel.RenderVideo}" Click="RenderTour_Click"
                          Style="{StaticResource PanelButton}"/>
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Picture area -->
    <Grid Grid.Column="1" x:Name="ImageHost" Background="#101012" ClipToBounds="True" SizeChanged="ImageHost_SizeChanged">
      <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False"/>
      <TextBlock x:Name="HintText" Text="{DynamicResource RenderPanel.Controls}" Foreground="#E5E5EA" FontSize="11"
                 Margin="14,0,14,46" VerticalAlignment="Bottom" TextWrapping="Wrap" Opacity="0.75" IsHitTestVisible="False"/>
      <Border VerticalAlignment="Bottom" Background="#CC1C1C1E" Padding="14,8">
        <DockPanel>
          <ProgressBar x:Name="RenderProgress" DockPanel.Dock="Right" Width="170" Height="8" Minimum="0" Maximum="1"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Foreground="#E5E5EA" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Text="{DynamicResource RenderPanel.Idle}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
