<UserControl x:Class="Guanacaste3D.Desktop.Controls.RenderPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="#101925" Foreground="#EAF0F6" Focusable="False" FontSize="13">
  <UserControl.Resources>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="PanelLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B3C4D6"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="PanelHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#90A6BC"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style x:Key="SliderValue" TargetType="TextBlock">
      <Setter Property="DockPanel.Dock" Value="Right"/><Setter Property="Width" Value="62"/>
      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="PanelCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EAF0F5"/>
      <Setter Property="Margin" Value="0,9,0,0"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- The panel is dark: every plain control inside it needs light text and a dark face, or its caption vanishes. -->
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0F5"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EAF0F5"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2A3D51"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#4A6882"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <!-- A translucent veil lightens any face colour on hover, so custom backgrounds keep their identity. -->
          <Border x:Name="Veil" CornerRadius="5" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Veil" Property="Opacity" Value="0.14"/>
            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#7FB4D6"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#6BD7C5"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.24"/></Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5"/>
            <Setter Property="Foreground" Value="#9FB2C3"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="#243447"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#3E5365"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,2,0,2"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="#243447"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#3E5365"/>
      <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#2E7D9A"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6C97B8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6BD7C5"/></Trigger>
          <!-- A disabled field stays dark with readable grey-blue text instead of turning pale. -->
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Frame" Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#8FA4B7"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="#1D2A38"/>
      <Setter Property="BorderBrush" Value="#344555"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="12,0,12,12"/>
    </Style>
    <!-- Section tabs: an icon above a short name, with an accent bar under the open one. -->
    <Style x:Key="SectionTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="4,9,4,7" Cursor="Hand">
              <Grid>
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                <Border x:Name="Bar" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="10,0,10,-7"
                        Background="{DynamicResource AccentBrush}" Visibility="Hidden"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/><Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
    </Style>
    <Style x:Key="TabText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
    </Style>
    <Style x:Key="RenderRailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#172332"/>
      <Setter Property="Foreground" Value="#DDEBF5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="57"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Padding" Value="4,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#244255"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ImageToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="ViewportToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E7F1F3"/><Setter Property="Background" Value="#233E46"/>
      <Setter Property="BorderBrush" Value="#3B5B63"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#315B62"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#18383E"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RenderPrimaryButton" TargetType="Button" BasedOn="{StaticResource ViewportToolButton}">
      <Setter Property="Background" Value="#087D83"/><Setter Property="BorderBrush" Value="#3AA7A3"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="PreviewSwitch" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E7F1F3"/><Setter Property="Background" Value="#233E46"/>
      <Setter Property="BorderBrush" Value="#3B5B63"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="SwitchChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchChrome" Property="Background" Value="#087D83"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchChrome" Property="BorderBrush" Value="#7BDCD0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SettingsColumn" Width="370" MinWidth="320" MaxWidth="760"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Background="#111A26">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#0C1521" BorderBrush="#304050" BorderThickness="0,0,1,0">
        <StackPanel x:Name="RenderModeRail" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0">
          <TextBlock Text="G3D" Foreground="#66D9C4" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
          <Button x:Name="RenderRailScene" Tag="0" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" ToolTip="Entorno, sol y luces">
            <StackPanel><TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Entorno" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailImage" Tag="1" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" ToolTip="Estilos, efectos y color">
            <StackPanel><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Imagen" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailCamera" Tag="2" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" ToolTip="Cámara y encuadre">
            <StackPanel><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Cámara" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailMaterials" Tag="3" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" ToolTip="Biblioteca de materiales y texturas">
            <StackPanel><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Material" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailQuality" Tag="4" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" ToolTip="Calidad, tamaño y equipo">
            <StackPanel><TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Calidad" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailAi" Click="AiRender_Click" Style="{StaticResource RenderRailButton}" ToolTip="Render con IA: prepara prompt e imagen para servicios externos">
            <StackPanel>
              <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Render IA" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <DockPanel Grid.Column="1" Background="#151F2D">
        <Border DockPanel.Dock="Top" Background="#1C2B3A" BorderBrush="#344555" BorderThickness="0,0,0,1" Padding="18,16">
          <StackPanel>
            <TextBlock Text="ESTUDIO DE RENDER" Foreground="#6BD7C5" FontSize="10.5" FontWeight="Bold"/>
            <TextBlock Text="Guanacaste 3D" Foreground="#F4F7FA" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

      <Border DockPanel.Dock="Top" Style="{StaticResource SettingsCard}" Margin="12,10,12,0" Padding="12,10" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="{DynamicResource RenderPanel.Scenes}" Style="{StaticResource PanelTitle}"/>
          <ComboBox x:Name="ScenePicker" ToolTip="{DynamicResource RenderPanel.ScenesHint}"/>
          <UniformGrid Columns="3" Margin="0,8,0,0">
            <Button x:Name="SaveSceneButton" Content="{DynamicResource RenderPanel.SceneSave}" Click="SaveRenderScene_Click" Style="{StaticResource ViewportToolButton}"/>
            <Button x:Name="OpenSceneButton" Content="{DynamicResource RenderPanel.SceneOpen}" Click="OpenRenderScene_Click" Style="{StaticResource ViewportToolButton}"/>
            <Button x:Name="DeleteSceneButton" Content="{DynamicResource RenderPanel.SceneDelete}" Click="DeleteRenderScene_Click" Style="{StaticResource ViewportToolButton}"/>
          </UniformGrid>
        </StackPanel>
      </Border>
      <!-- Render actions remain available in every settings section. -->
      <Border DockPanel.Dock="Top" Style="{StaticResource SettingsCard}" Margin="12,12,12,8">
        <StackPanel>
          <Button x:Name="PauseButton" Content="{DynamicResource RenderPanel.Pause}"
                  Click="PauseButton_Click" Style="{StaticResource ViewportToolButton}" MinHeight="34" Padding="16,6" IsEnabled="False"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ToggleButton x:Name="PreviewToggle" IsChecked="False" Style="{StaticResource PreviewSwitch}" Margin="0,0,4,0"
                          Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed"
                          Content="{DynamicResource RenderPanel.Preview}" ToolTip="{DynamicResource RenderPanel.PreviewHint}"/>
            <Button x:Name="ShowImageButton" Grid.Column="1" Grid.ColumnSpan="2" Content="{DynamicResource RenderPanel.ShowImage}" Click="ShowImage_Click"
                    IsEnabled="False" Style="{StaticResource ViewportToolButton}" Padding="10,7" MinHeight="34" ToolTip="{DynamicResource RenderPanel.ShowImageHint}"/>
            <Button x:Name="SaveButton" Grid.Row="1" Grid.ColumnSpan="2" Click="SaveButton_Click" IsEnabled="False" Style="{StaticResource ViewportToolButton}" Padding="8,7" MinHeight="34"
                    Margin="0,6,4,0" ToolTip="{DynamicResource RenderPanel.SaveImage}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource RenderPanel.SaveShort}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="CopyButton" Grid.Row="1" Grid.Column="2" Click="CopyButton_Click" IsEnabled="False" Style="{StaticResource ViewportToolButton}" Padding="10,7" MinHeight="34"
                    Margin="4,6,0,0" ToolTip="{DynamicResource RenderPanel.CopyImage}">
              <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <TabControl x:Name="SectionTabs" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0">
        <TabControl.Resources>
          <Style TargetType="TabItem" BasedOn="{StaticResource SectionTab}"/>
        </TabControl.Resources>
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <Border DockPanel.Dock="Top" Margin="12,0,12,4" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <UniformGrid Rows="1" IsItemsHost="True"/>
              </Border>
              <ContentPresenter ContentSource="SelectedContent"/>
            </DockPanel>
          </ControlTemplate>
        </TabControl.Template>

        <!-- Sun, sky and lights -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE706;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.Scene}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Scene}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Scenario}" Margin="0,4,0,4"/>
                  <ComboBox x:Name="ScenarioPicker" SelectedIndex="0" SelectionChanged="Lighting_Changed">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Sunny}" Tag="Sunny"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Overcast}" Tag="Overcast"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.GoldenHour}" Tag="GoldenHour"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Dusk}" Tag="Dusk"/>
                  </ComboBox>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.SkyPreset}"/>
                  <ComboBox x:Name="SkyPicker" SelectionChanged="Sky_Changed" ToolTip="{DynamicResource RenderPanel.SkyPresetHint}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,7,0,3" Text="Iluminación ambiental HDRI"/>
                  <WrapPanel>
                    <Button Content="Cargar HDRI…" Margin="0,0,7,0" Padding="9,5" Click="HdriLoad_Click"
                            ToolTip="Archivo Radiance RGBE .hdr de hasta 2048×1024. Cielo e iluminación global real."/>
                    <Button Content="Quitar HDRI" Padding="9,5" Click="HdriClear_Click"
                            ToolTip="Restaurar cielo solar procedural sin afectar materiales del modelo."/>
                  </WrapPanel>
                  <TextBlock x:Name="HdriNameText" Style="{StaticResource PanelHint}" Margin="0,4,0,6"
                             Text="Cielo físico procedural activo"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Rotación del HDRI (°)"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HdriYawSlider, StringFormat={}{0:0}°}"/>
                    <Slider x:Name="HdriYawSlider" Minimum="0" Maximum="360" Value="0" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Intensidad HDRI (pasos de luz)"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HdriExposureSlider, StringFormat={}{0:+0.0;-0.0;0} EV}"/>
                    <Slider x:Name="HdriExposureSlider" Minimum="-4" Maximum="4" Value="0" TickFrequency="0.25"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.CloudStyle}"/>
                  <ComboBox x:Name="CloudStylePicker" SelectionChanged="Lighting_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,6,0,2" Text="Forma de las nubes"/>
                  <DockPanel>
                    <Button Content="Generar nueva distribución de nubes" Padding="9,5" Click="NewClouds_Click"
                            ToolTip="Cambia la semilla del cielo. El resultado será repetible al guardar el proyecto."/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Semilla (distribución reproducible)"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=CloudSeedSlider, StringFormat={}{0:0}}"/>
                    <Slider x:Name="CloudSeedSlider" Minimum="0" Maximum="1023" Value="7" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Dirección de las nubes"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=CloudDirectionSlider, StringFormat={}{0:0}°}"/>
                    <Slider x:Name="CloudDirectionSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Turbidez atmosférica"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TurbiditySlider, StringFormat={}{0:0.0}}"/>
                    <Slider x:Name="TurbiditySlider" Minimum="1.7" Maximum="10" Value="2.8" TickFrequency="0.1"
                            ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Potencia solar"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SunStrengthSlider, StringFormat={}{0:0.00}}"/>
                    <Slider x:Name="SunStrengthSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                            ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Intensidad ambiental"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SkyStrengthSlider, StringFormat={}{0:0.00}}"/>
                    <Slider x:Name="SkyStrengthSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                            ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>


                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Hour}"/>
                  <Grid x:Name="SunControls"><StackPanel>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Date}" Margin="0,4,0,4"/>
                    <DatePicker x:Name="SunDatePicker" SelectedDateFormat="Short" SelectedDateChanged="Lighting_Changed" MinHeight="30"/>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Hour}"/>
                    <DockPanel>
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HourSlider, StringFormat={}{0:0.0} h}"/>
                      <Slider x:Name="HourSlider" Minimum="5" Maximum="19" Value="10" TickFrequency="0.25"
                              IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Clouds}"/>
                    <DockPanel>
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=CloudSlider, StringFormat={}{0:0} %}"/>
                      <Slider x:Name="CloudSlider" Minimum="0" Maximum="100" Value="30" TickFrequency="5"
                              IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"
                              ToolTip="{DynamicResource RenderPanel.CloudsHint}"/>
                    </DockPanel>
                  </StackPanel></Grid>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Latitude}"/>
                  <TextBox x:Name="LatitudeInput" Text="12.1" Width="96" HorizontalAlignment="Left"
                           TextChanged="Latitude_Changed" ToolTip="{DynamicResource RenderPanel.LatitudeHint}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <CheckBox x:Name="RenderClayCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0"
                            Content="{DynamicResource View3D.Clay}" ToolTip="{DynamicResource RenderPanel.ClayHint}"
                            Checked="ClayMode_Changed" Unchecked="ClayMode_Changed"/>
                  <CheckBox x:Name="HazeCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                            Content="{DynamicResource RenderPanel.Haze}" Checked="Haze_Changed" Unchecked="Haze_Changed"/>
                  <CheckBox x:Name="ArtificialLightsCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                            Content="{DynamicResource RenderPanel.ArtificialLights}" Checked="Lights_Changed" Unchecked="Lights_Changed"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Exposure, picture style and effects -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xEB9F;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.Image}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <!-- Effect stack: the finishing effects in use, each with an eye to switch it off and its own settings. -->
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="FX" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button x:Name="AddFxButton" Grid.Column="1" Click="AddFx_Click" Style="{StaticResource ViewportToolButton}" Padding="12,6" MinHeight="32"
                            ToolTip="Agregar un efecto a la imagen">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="FX" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="FxMenuButton" Grid.Column="2" Click="FxMenu_Click" Style="{StaticResource ViewportToolButton}" Padding="9,6" MinHeight="32"
                            Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Guardar o cargar un estilo de efectos"/>
                  </Grid>
                  <StackPanel x:Name="FxStackList" Margin="0,10,0,0"/>
                  <TextBlock x:Name="FxEmptyHint" Style="{StaticResource PanelHint}" Margin="0,8,0,0"
                             Text="Sin efectos de acabado. Pulsa «FX» para agregar el primero."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Image}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Style}" Margin="0,4,0,4"/>
                  <ComboBox x:Name="StylePicker" SelectionChanged="Style_Changed" ToolTip="{DynamicResource RenderPanel.StyleHint}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,9,0,4" Text="Filtro de color fotográfico (LUT)"/>
                  <ComboBox x:Name="LutPicker" SelectionChanged="Lut_Changed"
                            ToolTip="Biblioteca de filtros integrada, comparable al flujo de gradación profesional; archivos .cube propios."/>
                  <WrapPanel Margin="0,6,0,3">
                    <Button Content="Importar .cube…" Padding="9,4" Margin="0,0,6,0" Click="LutLoad_Click"/>
                    <Button Content="Quitar filtro" Padding="9,4" Click="LutClear_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="LutNameText" Style="{StaticResource PanelHint}" Text="LUT desactivado" Margin="0,2,0,5"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Intensidad del filtro"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=LutStrengthSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="LutStrengthSlider" Minimum="0" Maximum="1" Value="0.7" TickFrequency="0.05"
                            ValueChanged="LutStrength_Changed"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Look}"/>
                  <ComboBox x:Name="LookPicker" SelectedIndex="0" SelectionChanged="Look_Changed">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.LookPhotographic}" Tag="AgX"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.LookContrast}" Tag="Aces"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.LookSoft}" Tag="Soft"/>
                  </ComboBox>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Exposure}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ExposureSlider, StringFormat={}{0:+0.0;-0.0;0.0} EV}"/>
                    <Slider x:Name="ExposureSlider" Minimum="-3" Maximum="3" Value="0" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Temperature}"/>
                  <DockPanel>
                    <TextBlock x:Name="TemperatureText" Style="{StaticResource SliderValue}" Text="5500 K"/>
                    <Slider x:Name="TemperatureSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Temperature_Changed"
                            ToolTip="{DynamicResource RenderPanel.TemperatureHint}"/>
                  </DockPanel>
                  <CheckBox x:Name="AutoExposureCheck" Style="{StaticResource PanelCheck}" IsChecked="True" Margin="0,12,0,0"
                            Content="{DynamicResource RenderPanel.AutoExposure}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
                  <CheckBox x:Name="BloomCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                            Content="{DynamicResource RenderPanel.Bloom}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
                  <CheckBox x:Name="VignetteCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                            Content="{DynamicResource RenderPanel.Vignette}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
                </StackPanel>
              </Border>
              <!-- The effect sliders live in the FX stack now; this card stays only because the stack edits these very controls. -->
              <Border x:Name="LegacyEffectsCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Effects}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Highlights}" Margin="0,4,0,4"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HighlightsSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="HighlightsSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Shadows}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ShadowsSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="ShadowsSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.ContrastAdjust}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ContrastSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="ContrastSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.SaturationAdjust}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SaturationSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="SaturationSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Vibrance}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=VibranceSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="VibranceSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Tint}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="TintSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Glare}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=GlareSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="GlareSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Fog}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=FogSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="FogSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Sharpen}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SharpenSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="SharpenSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Aberration}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=AberrationSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="AberrationSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Grain}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=GrainSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="GrainSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <CheckBox x:Name="MonochromeCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0,12,0,0"
                            Content="{DynamicResource RenderPanel.Monochrome}" Checked="Finish_Changed" Unchecked="Finish_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource Render.Weather.Wet}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=WetnessSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="WetnessSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource Render.Grass.Height}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=GrassSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="GrassSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource Render.Wind.Strength}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=WindSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="WindSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource RenderPanel.Rain}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=RainSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="RainSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Rain_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Snow}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SnowSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="SnowSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Camera.LensFlare}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=LensFlareSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="LensFlareSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Camera.LightRays}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=LightRaysSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="LightRaysSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Camera.TiltShift}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TiltShiftSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="TiltShiftSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Camera.TiltShiftPosition}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TiltShiftPositionSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="TiltShiftPositionSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <Button x:Name="FireButton" Content="{DynamicResource Render.Fire.Open}" Margin="0,12,0,0" Padding="10,5" HorizontalAlignment="Left"
                          Click="Fire_Click"/>
                  <CheckBox x:Name="OceanCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0,12,0,0"
                            Content="{DynamicResource Render.Ocean.Use}" Checked="Ocean_Changed" Unchecked="Ocean_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Ocean.Level}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=OceanLevelSlider, StringFormat={}{0:0.0} m}"/>
                    <Slider x:Name="OceanLevelSlider" Minimum="-5" Maximum="5" Value="-0.5" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" ValueChanged="Ocean_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Ocean.Waves}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=OceanWavesSlider, StringFormat={}{0:0.0}×}"/>
                    <Slider x:Name="OceanWavesSlider" Minimum="0.3" Maximum="3" Value="1" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" ValueChanged="Ocean_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Ocean.Tint}"/>
                  <ComboBox x:Name="OceanTintPicker" SelectionChanged="Ocean_SelectionChanged"/>
                  <CheckBox x:Name="LayersAnimationCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0,12,0,0"
                            Content="{DynamicResource Render.Layers.Use}" Checked="Layers_Changed" Unchecked="Layers_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource RenderPanel.HighlightMaterial}"/>
                  <ComboBox x:Name="HighlightPicker" SelectedIndex="0" SelectionChanged="Highlight_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.HighlightDim}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HighlightDimSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="HighlightDimSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Camera, navigation and the walkthrough -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE722;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.CameraTab}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <!-- The photographic lens: focal length, level, shift and focus, as in Lumion's photo camera. -->
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Lens}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.FocalLength}"/>
                  <DockPanel>
                    <TextBlock x:Name="FocalValueText" Style="{StaticResource SliderValue}" Text="29 mm"/>
                    <Slider x:Name="FocalSlider" Minimum="10" Maximum="135" Value="29" SmallChange="1" LargeChange="5"
                            ValueChanged="FocalSlider_Changed"/>
                  </DockPanel>
                  <TextBlock x:Name="FieldOfViewText" Style="{StaticResource PanelHint}" Margin="0,2,0,6"/>
                  <WrapPanel x:Name="FocalPresets"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Roll}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=RollSlider, StringFormat={}{0:0.0}°}"/>
                    <Slider x:Name="RollSlider" Minimum="-45" Maximum="45" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.ShiftY}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ShiftYSlider, StringFormat={}{0:0} %}"/>
                    <Slider x:Name="ShiftYSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.ShiftX}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ShiftXSlider, StringFormat={}{0:0} %}"/>
                    <Slider x:Name="ShiftXSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.FocusDistance}"/>
                  <DockPanel>
                    <TextBlock x:Name="FocusValueText" Style="{StaticResource SliderValue}" Text="Auto"/>
                    <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <Button Content="{DynamicResource RenderPanel.PickFocus}" Click="PickFocus_Click" x:Name="PickFocusButton"
                          Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                  <CheckBox x:Name="ApertureCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                            Content="{DynamicResource RenderPanel.ApertureOn}" Checked="Aperture_Changed" Unchecked="Aperture_Changed"/>
                  <DockPanel x:Name="AperturePanel" Visibility="Collapsed">
                    <TextBlock x:Name="ApertureValueText" Style="{StaticResource SliderValue}" Text="f/2.8"/>
                    <Slider x:Name="ApertureSlider" Minimum="1.2" Maximum="22" Value="2.8" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelHint}" Text="{DynamicResource RenderPanel.LensHint}" Margin="0,2,0,0"/>
                  <Button Content="{DynamicResource RenderPanel.ResetLens}" Click="ResetLens_Click"
                          Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Navigation}"/>
                  <CheckBox x:Name="VerticalsCheck" Style="{StaticResource PanelCheck}" IsChecked="True" Margin="0,4,0,0"
                            Content="{DynamicResource RenderPanel.Verticals}" Checked="Camera_Changed" Unchecked="Camera_Changed"/>
                  <CheckBox x:Name="CollisionCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                            Content="{DynamicResource RenderPanel.Collisions}" ToolTip="{DynamicResource RenderPanel.CollisionsHint}"
                            Checked="Collision_Changed" Unchecked="Collision_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.DepthOfField}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=DepthOfFieldSlider, StringFormat={}{0:0} %}"/>
                    <Slider x:Name="DepthOfFieldSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="Camera_SliderChanged"/>
                  </DockPanel>
                  <Button Content="{DynamicResource RenderPanel.FrameAll}" Click="FrameAll_Click"
                          Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Expander x:Name="TourExpander" Foreground="{DynamicResource PrimaryTextBrush}" IsExpanded="True">
                  <Expander.Header>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Tour}" Margin="0"/>
                  </Expander.Header>
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource PanelHint}" Text="{DynamicResource RenderPanel.TourHint}" Margin="0,0,0,8"/>
                    <ListBox x:Name="MarksList" Height="150" SelectionChanged="MarksList_SelectionChanged"/>
                    <WrapPanel Margin="0,10,0,0">
                      <Button Content="{DynamicResource RenderPanel.AddMark}" Click="AddMark_Click" Style="{StaticResource PanelButton}"/>
                      <Button x:Name="GoToMarkButton" Content="{DynamicResource RenderPanel.GoToMark}" Click="GoToMark_Click"
                              Style="{StaticResource PanelButton}" IsEnabled="False"/>
                      <Button x:Name="RemoveMarkButton" Content="{DynamicResource RenderPanel.RemoveMark}" Click="RemoveMark_Click"
                              Style="{StaticResource PanelButton}" IsEnabled="False"/>
                    </WrapPanel>
                    <Grid Margin="0,2,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.MarkSeconds}" Margin="0,4,0,4"/>
                        <TextBox x:Name="MarkSecondsInput" Text="4" Width="80" HorizontalAlignment="Left" LostFocus="MarkSeconds_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Fps}" Margin="0,4,0,4"/>
                        <ComboBox x:Name="FpsPicker" SelectedIndex="1" Width="96" HorizontalAlignment="Left">
                          <ComboBoxItem Content="24" Tag="24"/><ComboBoxItem Content="30" Tag="30"/><ComboBoxItem Content="60" Tag="60"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                      <Button x:Name="PlayTourButton" Content="{DynamicResource RenderPanel.PlayTour}" Click="PlayTour_Click"
                              Style="{StaticResource PanelButton}"/>
                      <Button x:Name="RenderTourButton" Content="{DynamicResource RenderPanel.RenderVideo}" Click="RenderTour_Click"
                              Style="{StaticResource PanelButton}"/>
                    </WrapPanel>
                  </StackPanel>
                </Expander>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Materials of each surface -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE790;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.Materials}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Materials}"/>
                  <TextBlock Style="{StaticResource PanelHint}" Text="{DynamicResource RenderPanel.MaterialsHint}"/>
                  <TextBlock x:Name="MaterialScopeInfo" Style="{StaticResource PanelHint}" Text="Material general por categoría"/>
                  <Button x:Name="MaterialScopeReset" Visibility="Collapsed" Content="Volver a materiales generales"
                          HorizontalAlignment="Left" Margin="0,6,0,3" Padding="8,4" Click="MaterialScopeReset_Click"/>
                  <Button x:Name="MaterialPickerButton" Content="Biblioteca de materiales (esferas)…" Margin="0,12,0,0" Padding="10,8"
                          HorizontalAlignment="Stretch" FontWeight="SemiBold" Click="MaterialPicker_Click"
                          ToolTip="Abre la biblioteca grande: esferas agrupadas por tipo, un clic aplica el material a la superficie elegida"/>
                  <!-- Eight thumbnails per page, generated off the UI thread only when expanded. -->
                  <Expander x:Name="GalleryExpander" IsExpanded="True" Margin="0,12,0,12"
                            Expanded="GalleryExpanded" Collapsed="GalleryCollapsed"
                            Foreground="#F0F6FB" Background="#1B2A3A">
                    <Expander.Header>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource RenderGallery.Title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{DynamicResource RenderGallery.Subtitle}" Foreground="#9CB5C8" FontSize="11" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="2,12,2,4">
                      <TextBlock Text="{DynamicResource RenderGallery.Target}" Style="{StaticResource PanelLabel}" Margin="0,0,0,4"/>
                      <ComboBox x:Name="GalleryTargetPicker" SelectionChanged="GalleryFilter_Changed"
                                ToolTip="{DynamicResource RenderGallery.TargetHint}"/>
                      <TextBlock Text="{DynamicResource RenderGallery.Filter}" Style="{StaticResource PanelLabel}" Margin="0,10,0,4"/>
                      <ComboBox x:Name="GalleryGroupPicker" SelectedIndex="0" SelectionChanged="GalleryFilter_Changed">
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Presets}" Tag="presets"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Trees}" Tag="trees"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Bark}" Tag="bark"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Foliage}" Tag="foliage"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Other}" Tag="other"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Pbr}" Tag="pbr"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.All}" Tag="all"/>
                      </ComboBox>
                      <Button x:Name="GalleryImportPbrButton" Content="{DynamicResource RenderGallery.AddPbr}"
                              Click="GalleryImportPbr_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                              Padding="12,8" Background="#25445A" Foreground="#F5F9FC" BorderBrush="#4B7280"/>
                      <TextBox x:Name="GallerySearch" Margin="0,9,0,10"
                               TextChanged="GalleryFilter_Changed"
                               ToolTip="{DynamicResource RenderGallery.SearchHint}"/>
                      <WrapPanel x:Name="GalleryTiles" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="GalleryFeedback" Foreground="#9CB5C8" TextWrapping="Wrap"
                                 FontSize="11" Margin="0,6,0,0"/>
                      <DockPanel Margin="0,10,0,0">
                        <Button x:Name="GalleryPreviousButton" DockPanel.Dock="Left"
                                Content="‹" MinWidth="42" Padding="10,5"
                                Click="GalleryPrevious_Click"/>
                        <Button x:Name="GalleryNextButton" DockPanel.Dock="Right"
                                Content="›" MinWidth="42" Padding="10,5"
                                Click="GalleryNext_Click"/>
                        <TextBlock x:Name="GalleryPageText" HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#DBE7F3" FontSize="12"/>
                      </DockPanel>
                      <Border x:Name="GalleryAppearanceEditor" Background="#1F3042"
                              BorderBrush="#406075" BorderThickness="1" CornerRadius="9"
                              Padding="12" Margin="0,15,0,0">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource RenderGallery.Appearance}" FontWeight="SemiBold"
                                     Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                          <TextBlock x:Name="GalleryAppearanceName" Text="{DynamicResource RenderGallery.NoMaterial}"
                                     TextWrapping="Wrap" Foreground="#ABC3D1" FontSize="11" Margin="0,0,0,8"/>
                          <!-- A stylised ball that answers the sliders at once; the real result is in the render. -->
                          <Image x:Name="GalleryPreviewSphere" Width="176" Height="176" Margin="0,2,0,12" HorizontalAlignment="Center"
                                 RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Vista previa del material (aproximada)"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryRoughnessValue" DockPanel.Dock="Right" Foreground="#70DAC9"
                                       Text="0.70" Width="45" TextAlignment="Right"/>
                            <TextBlock Text="{DynamicResource RenderGallery.Roughness}" Foreground="#EDF5FA"/>
                          </DockPanel>
                          <Slider x:Name="GalleryRoughnessSlider" Minimum="0.02" Maximum="1" Value="0.7"
                                  SmallChange="0.01" TickFrequency="0.01" Margin="0,2,0,10"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryMetallicValue" DockPanel.Dock="Right" Foreground="#70DAC9"
                                       Text="0.00" Width="45" TextAlignment="Right"/>
                            <TextBlock Text="{DynamicResource RenderGallery.Metallic}" Foreground="#EDF5FA"/>
                          </DockPanel>
                          <Slider x:Name="GalleryMetallicSlider" Minimum="0" Maximum="1" Value="0"
                                  SmallChange="0.01" TickFrequency="0.01" Margin="0,2,0,10"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryReliefValue" DockPanel.Dock="Right" Foreground="#70DAC9"
                                       Text="0.30" Width="45" TextAlignment="Right"/>
                            <TextBlock Text="{DynamicResource RenderGallery.Relief}" Foreground="#EDF5FA"/>
                          </DockPanel>
                          <Slider x:Name="GalleryReliefSlider" Minimum="0" Maximum="1" Value="0.3"
                                  SmallChange="0.01" TickFrequency="0.01" Margin="0,2,0,8"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryScaleValue" DockPanel.Dock="Right" Foreground="#70DAC9"
                                       Text="1.00 m" Width="55" TextAlignment="Right"/>
                            <TextBlock Text="Escala de mapa" Foreground="#EDF5FA"
                                       ToolTip="Metros que cubre una copia de la imagen."/>
                          </DockPanel>
                          <Slider x:Name="GalleryScaleSlider" Minimum="0.05" Maximum="10" Value="1"
                                  SmallChange="0.05" TickFrequency="0.05" Margin="0,2,0,10"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <TextBlock Text="Colorización" Foreground="#EDF5FA" Margin="0,0,0,6"
                                     ToolTip="Tiñe el material sin cambiar su imagen."/>
                          <WrapPanel x:Name="GalleryTintSwatches" Margin="0,0,0,8"/>
                          <WrapPanel Margin="0,4,0,8">
                            <Button x:Name="GalleryApplyAppearanceButton"
                                    Content="{DynamicResource RenderGallery.Apply}"
                                    Click="GalleryApplyAppearance_Click" Padding="11,7"
                                    Background="#246E68" Foreground="White" Margin="0,0,7,5"/>
                            <Button x:Name="GalleryResetAppearanceButton"
                                    Content="{DynamicResource RenderGallery.Reset}"
                                    Click="GalleryResetAppearance_Click" Padding="11,7" Margin="0,0,0,5"/>
                          </WrapPanel>
                          <TextBlock Text="{DynamicResource RenderGallery.MapChannels}" Foreground="#EDF5FA"
                                     FontWeight="SemiBold" Margin="0,4,0,6"/>
                          <WrapPanel x:Name="GalleryPbrMapCards" HorizontalAlignment="Center"/>
                          <TextBlock Text="{DynamicResource RenderGallery.MapHint}" Foreground="#8FA8BC"
                                     TextWrapping="Wrap" FontSize="10.5" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Expander>
                  <CheckBox x:Name="StoneDetailCheck" Margin="0,8,0,4" IsChecked="False"
                            Content="Relieve geométrico en piedra natural"
                            ToolTip="Añade microgeometría auténtica solo al render de muros de piedra; hasta 80 000 triángulos adicionales. Desactivar para máquinas lentas."
                            Checked="StoneDetail_Changed" Unchecked="StoneDetail_Changed"/>
                  <TextBox x:Name="MaterialSearch" Margin="0,10,0,8" ToolTip="Buscar materiales por nombre, familia o identificador, con o sin tildes. Abre el selector para ver los resultados."/>
                  <StackPanel x:Name="MaterialRows"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Quality, size and computer resources -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE9E9;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.QualityTab}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Quality}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.QualityLabel}" Margin="0,4,0,4"/>
                  <ComboBox x:Name="QualityPicker" SelectedIndex="0" SelectionChanged="Quality_Changed">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Auto}" Tag="Auto"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Draft}" Tag="Draft"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Standard}" Tag="Standard"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.High}" Tag="High"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Final}" Tag="Final"/>
                  </ComboBox>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Size}"/>
                  <ComboBox x:Name="SizePicker" SelectedIndex="0" SelectionChanged="Quality_Changed">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeView}" Tag="0x0"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeHd}" Tag="1280x720"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeFullHd}" Tag="1920x1080"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeQhd}" Tag="2560x1440"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeUhd}" Tag="3840x2160"/>
                  </ComboBox>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.BucketSize}" Margin="0,12,0,4"/>
                  <ComboBox x:Name="BucketSizePicker" SelectedIndex="0" ToolTip="{DynamicResource RenderPanel.BucketSizeHint}">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.BucketAuto}" Tag="0"/>
                    <ComboBoxItem Content="8 × 8 px" Tag="8"/>
                    <ComboBoxItem Content="16 × 16 px" Tag="16"/>
                    <ComboBoxItem Content="32 × 32 px" Tag="32"/>
                    <ComboBoxItem Content="64 × 64 px" Tag="64"/>
                    <ComboBoxItem Content="128 × 128 px" Tag="128"/>
                  </ComboBox>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Resources}"/>
                  <ComboBox x:Name="ResourcePicker" SelectedIndex="1" SelectionChanged="Quality_Changed" Margin="0,4,0,0">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Eco}" Tag="Eco"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Balanced}" Tag="Balanced"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Maximum}" Tag="Maximum"/>
                  </ComboBox>
                  <TextBlock x:Name="MemoryText" Style="{StaticResource PanelHint}" Margin="0,10,0,0"/>
                  <DockPanel Margin="0,10,0,0">
                    <Button x:Name="RecalibrateButton" DockPanel.Dock="Right" Padding="12,5" MinHeight="30"
                            Content="{DynamicResource RenderPanel.Recalibrate}" ToolTip="{DynamicResource RenderPanel.RecalibrateHint}"
                            Click="Recalibrate_Click"/>
                    <TextBlock x:Name="HardwareText" Style="{StaticResource PanelHint}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="{DynamicResource RenderPanel.Calibrating}"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      </DockPanel>
    </Grid>

    <!-- Drag to give the settings or the picture more room. -->
    <GridSplitter x:Name="SettingsSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                  Background="{DynamicResource PanelBorderBrush}" Cursor="SizeWE" Focusable="False"/>

    <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Background="#101D29" LastChildFill="True">
      <Button x:Name="CopyCurrentViewButton" Content="{DynamicResource RenderPanel.CopyViewForAi}" Click="CopyCurrentView_Click"
              DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0"
              Padding="14,9" MinHeight="38" FontWeight="SemiBold"
              Background="#DB174B5A" Foreground="#FFFFFF" BorderBrush="#72D8C4"
              ToolTip="{DynamicResource RenderPanel.CopyViewForAiHint}"/>
        <ContentControl x:Name="OutputModeHost" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
      </DockPanel>
    <Grid x:Name="ImageHost" ClipToBounds="True" SizeChanged="ImageHost_SizeChanged"
          AllowDrop="True" DragOver="MaterialDragOver" Drop="MaterialDrop">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#91C5DF" Offset="0"/><GradientStop Color="#DCECF0" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Viewport3D x:Name="InteractiveViewport" IsHitTestVisible="False" ClipToBounds="True"/>
      <!-- A still of the viewport with the active style and filters applied; hidden the moment the camera moves. -->
      <Image x:Name="StyledPreviewImage" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <Border x:Name="FinalImageBorder" Visibility="Collapsed" Margin="28,24,28,176" Background="#F9FBFD" BorderBrush="#4A6579" BorderThickness="1" CornerRadius="8" Padding="8">
        <Border.Effect><DropShadowEffect Color="#475569" BlurRadius="24" ShadowDepth="4" Opacity="0.22"/></Border.Effect>
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False"/>
      </Border>
      <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" ClipToBounds="True"/>

      <!-- Lightweight sampled telemetry. GPU shows renderer usage (zero for the current CPU backend). -->
      <Border x:Name="RenderTelemetryPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
              Background="#DD1E293B" BorderBrush="#445B718B" BorderThickness="1" CornerRadius="10" Padding="12,10"
              Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel Width="267">
          <TextBlock Text="{DynamicResource RenderPanel.Telemetry}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Foreground="White" VerticalAlignment="Center"/>
            <Canvas Grid.Column="1" Width="120" Height="24" ClipToBounds="True">
              <Polyline x:Name="CpuLine" Stroke="#66D9C4" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Canvas>
            <TextBlock x:Name="CpuUsageText" Grid.Column="2" Foreground="White" Text="—" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
          </Grid>
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="RAM" Foreground="White" VerticalAlignment="Center"/>
            <Canvas Grid.Column="1" Width="120" Height="24" ClipToBounds="True">
              <Polyline x:Name="RamLine" Stroke="#93B8FC" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Canvas>
            <TextBlock x:Name="RamUsageText" Grid.Column="2" Foreground="White" Text="—" TextAlignment="Right" VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="GPU" Foreground="White" VerticalAlignment="Center"/>
            <Canvas Grid.Column="1" Width="120" Height="24" ClipToBounds="True">
              <Polyline x:Name="GpuLine" Stroke="#F4B76D" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Canvas>
            <TextBlock Grid.Column="2" Foreground="#D7E0ED" Text="0 % GRE" TextAlignment="Right" VerticalAlignment="Center" FontSize="10.5"/>
          </Grid>
          <TextBlock Text="{DynamicResource RenderPanel.GpuCpuBackend}" Foreground="#BBC9D9" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <!-- Effect picker: categories on the left, one tile per effect on the right, like Lumion's "Select Photo Effect". -->
      <Border x:Name="FxPicker" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12"
              MaxWidth="660" MaxHeight="430" Panel.ZIndex="10" PreviewKeyDown="FxPicker_KeyDown" KeyboardNavigation.TabNavigation="Cycle" CornerRadius="10" Background="#F2182633" BorderBrush="#4A6870" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,10,0,10">
            <Button Click="FxPickerClose_Click" HorizontalAlignment="Left" Margin="12,0,0,0" Style="{StaticResource ViewportToolButton}"
                    Padding="10,5" MinHeight="30" Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Cerrar"/>
            <TextBlock Text="Seleccionar efecto de foto" Foreground="#F1F5F9" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
            <Label Content="_Buscar" Target="{Binding ElementName=FxSearch}" Foreground="White"/>
            <TextBox x:Name="FxSearch" TextChanged="FxSearch_Changed" AutomationProperties.Name="Buscar efectos" ToolTip="Buscar en todas las categorías"/>
          </DockPanel>
          <ScrollViewer DockPanel.Dock="Left" Width="135" VerticalScrollBarVisibility="Auto" Margin="8,0,0,8">
            <StackPanel x:Name="FxCategoryList"/>
          </ScrollViewer>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
            <WrapPanel x:Name="FxTiles"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border x:Name="InteractiveHintCard" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,18,0,0" Padding="12,9" CornerRadius="8"
              Background="#D91A3038" BorderBrush="#526F75" BorderThickness="1" IsHitTestVisible="False">
        <StackPanel>
          <TextBlock Text="{DynamicResource RenderPanel.InteractiveTitle}" Foreground="#D8F4EF" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock x:Name="HintText" Text="{DynamicResource RenderPanel.InteractiveHint}" Foreground="#B9CDD0" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,170" Padding="6" CornerRadius="10"
              Background="#EA142A31" BorderBrush="#4A6870" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="OrbitLeftButton" Style="{StaticResource ViewportToolButton}" Click="OrbitLeft_Click"
                  Content="{DynamicResource RenderPanel.OrbitLeft}" ToolTip="{DynamicResource RenderPanel.OrbitLeftHint}"/>
          <Button x:Name="OrbitRightButton" Style="{StaticResource ViewportToolButton}" Click="OrbitRight_Click"
                  Content="{DynamicResource RenderPanel.OrbitRight}" ToolTip="{DynamicResource RenderPanel.OrbitRightHint}"/>
          <Button x:Name="FrameModelButton" Style="{StaticResource ViewportToolButton}" Click="FrameModel_Click"
                  Content="{DynamicResource RenderPanel.FrameModel}" ToolTip="{DynamicResource RenderPanel.FrameModelHint}"/>
          <Border Width="1" Margin="6,4" Background="#4A6870"/>
          <Button x:Name="FxBarButton" Style="{StaticResource ViewportToolButton}" Click="AddFx_Click" ToolTip="Efectos de imagen">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="FX" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="TheaterButton" Style="{StaticResource ViewportToolButton}" Click="Theater_Click" ToolTip="Ocultar los paneles para ver solo la imagen">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TheaterText" Text="Teatro" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <!-- Photo strip: saved views with their own style and filters, rendered one by one or all at once. -->
      <Border x:Name="PhotoStrip" VerticalAlignment="Bottom" Margin="0,0,0,41" Height="124" Background="#F20F1B26"
              BorderBrush="#38505A" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="14,0,10,0" Width="150">
            <Button x:Name="NewPhotoButton" Click="NewPhoto_Click" Style="{StaticResource RenderPrimaryButton}" MinHeight="40"
                    ToolTip="Guarda la vista actual como una foto con sus propios estilos y filtros (Ctrl+1 … Ctrl+0)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Nueva foto" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <CheckBox x:Name="StylePreviewCheck" IsChecked="True" Margin="0,9,0,0" Foreground="#C9D8E4" FontSize="11.5"
                      Content="Ver estilo en vivo" Checked="StylePreview_Changed" Unchecked="StylePreview_Changed"
                      ToolTip="Muestra el estilo y los filtros sobre la vista cuando dejas de mover la cámara."/>
          </StackPanel>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,2">
            <StackPanel x:Name="PhotoCards" Orientation="Horizontal" VerticalAlignment="Center"/>
          </ScrollViewer>
          <TextBlock x:Name="PhotoEmptyHint" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                     Foreground="#8FA6B9" FontSize="12" TextWrapping="Wrap" MaxWidth="420" IsHitTestVisible="False"
                     Text="Navega hasta un buen encuadre y pulsa «Nueva foto». Cada foto guarda su cámara, estilo y filtros."/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,16,0" Width="150">
            <Button x:Name="RenderPhotosButton" Click="RenderPhotos_Click" Style="{StaticResource RenderPrimaryButton}" MinHeight="44"
                    ToolTip="Renderiza una foto, varias o todas de una vez">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Renderizar…" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="PhotoCountText" Foreground="#8FA6B9" FontSize="11" Margin="0,7,0,0" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Mode switch, movie timeline and panorama bar are built in render-panel-modes.cs. -->
      <Grid x:Name="ModeOverlayHost"/>
      <Border VerticalAlignment="Bottom" Background="#12232C" BorderBrush="#38505A"
              BorderThickness="0,1,0,0" Padding="18,9">
        <DockPanel>
          <Button x:Name="RenderButton" DockPanel.Dock="Right" Click="RenderButton_Click" MinHeight="40" MinWidth="155"
                  Margin="14,0,0,0" FontSize="14" Style="{StaticResource RenderPrimaryButton}"
                  Content="{DynamicResource RenderPanel.Render}"/>
          <StackPanel x:Name="RenderProgressPanel" DockPanel.Dock="Right" Width="285" Margin="16,0,0,0"
                      Visibility="Collapsed">
            <ProgressBar x:Name="RenderProgress" Height="12" Minimum="0" Maximum="1"
                         VerticalAlignment="Center"/>
            <Grid Margin="0,5,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="RenderElapsedText" Text="00:00:00" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5"
                         ToolTip="{DynamicResource RenderPanel.ElapsedHint}"/>
              <TextBlock x:Name="RenderRemainingText" Grid.Column="1" Text="—" Foreground="{DynamicResource SecondaryTextBrush}"
                         FontSize="11" ToolTip="{DynamicResource RenderPanel.RemainingHint}"/>
            </Grid>
          </StackPanel>
          <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
          <TextBlock x:Name="StatusText" Foreground="#D7E8E7" FontSize="12"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{DynamicResource RenderPanel.Idle}"/>
        </DockPanel>
      </Border>
    </Grid>
    </DockPanel>
  </Grid>
</UserControl>
