<UserControl x:Class="Guanacaste3D.Desktop.Controls.StartScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
  <UserControl.Resources>
    <Style x:Key="StartActionButton" TargetType="Button">
      <Setter Property="Height" Value="39"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="#F4F4F4"/>
      <Setter Property="BorderBrush" Value="#C1C1C1"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StartNavButton" TargetType="RadioButton">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Row" Background="Transparent" Padding="36,12">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#E6E6E6"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Row" Property="Background" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StartLink" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#EDEDED"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource RibbonHoverBorderBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A file tile: the picture on white inside a grey card, a badge for the file type, the name and the date. -->
    <DataTemplate x:Key="TileTemplate">
      <Border Width="185" Height="262" Margin="0,0,15,15" Background="#ECECEC" BorderBrush="#DDDDDD"
              BorderThickness="1" ToolTip="{Binding ToolTip}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="139" Background="#ECECEC">
            <Border Width="113" Height="113" Background="White"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Background="{DynamicResource FileTabBrush}"
                    Padding="4,1" CornerRadius="2">
              <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9" FontWeight="Bold"/>
            </Border>
          </Grid>
          <Border DockPanel.Dock="Top" Height="1" Background="#DADADA"/>
          <StackPanel Margin="12,12,12,0">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="43"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,12,0,0" Foreground="#4C5661"
                       TextTrimming="CharacterEllipsis"/>
            
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="RowTemplate">
      <Grid Height="52" Margin="0,0,0,2" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Border Width="44" Height="44" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
          <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="262"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: what to do. -->
    <DockPanel Background="#F0F0F0">
      <StackPanel DockPanel.Dock="Top" Margin="35,64,55,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
          <Image Source="{StaticResource Brand.Logo}" Width="26" Height="26" Margin="0,0,7,0"/>
          <TextBlock Text="{DynamicResource App.Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource Start.Projects}" FontSize="13" Foreground="#555555" Margin="0,0,0,10"/>
        <Button x:Name="OpenProjectButton" Content="{DynamicResource Start.Open}" Style="{StaticResource StartActionButton}"
                Click="OpenProject_Click"/>
        <Button x:Name="NewProjectButton" Content="{DynamicResource Start.New}" Style="{StaticResource StartActionButton}"
                Click="NewProject_Click"/>
        <TextBlock Text="{DynamicResource Start.Families}" FontSize="13" Foreground="#555555" Margin="0,24,0,10"/>
        <Button Content="{DynamicResource Start.Open}" Style="{StaticResource StartActionButton}" Click="OpenFamily_Click"/>
        <Button Content="{DynamicResource Start.New}" Style="{StaticResource StartActionButton}" Click="NewFamily_Click"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="35,0,35,34">
        <Border Height="1" Background="#D4D4D4" Margin="0,0,0,26"/>
        <Button Content="{DynamicResource Start.About}" Style="{StaticResource StartLink}" Click="About_Click"/>
        <Button x:Name="BackToProjectLink" Content="{DynamicResource Start.BackToProject}" Style="{StaticResource StartLink}"
                Click="BackToProject_Click" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel Margin="0,42,0,0">
        <RadioButton x:Name="RecentTab" Content="{DynamicResource Start.Recent}" Style="{StaticResource StartNavButton}"
                     GroupName="StartPages" IsChecked="True" Checked="Page_Checked"/>
        <RadioButton x:Name="SamplesTab" Content="{DynamicResource Start.Samples}" Style="{StaticResource StartNavButton}"
                     GroupName="StartPages" Checked="Page_Checked"/>
      </StackPanel>
    </DockPanel>

    <!-- Right: the files. -->
    <DockPanel Grid.Column="1" Margin="18,68,18,0">
      <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" FontSize="24" FontWeight="Normal" Margin="0,0,0,24"
                 Foreground="{DynamicResource PrimaryTextBrush}"/>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ToggleButton x:Name="ListModeButton" Content="&#xE8FD;" Style="{StaticResource ToolToggle}"
                        ToolTip="{DynamicResource Start.ListView}" Click="ListMode_Click"/>
          <ToggleButton x:Name="GridModeButton" Content="&#xF0E2;" Style="{StaticResource ToolToggle}" IsChecked="True"
                        ToolTip="{DynamicResource Start.GridView}" Click="GridMode_Click"/>
          <TextBlock Text="{DynamicResource Start.SortBy}" FontSize="14" Margin="10,0,14,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
          <ComboBox x:Name="SortPicker" Width="196" FontSize="14" SelectionChanged="Sort_Changed">
            <ComboBoxItem Content="{DynamicResource Start.SortDate}" Tag="Date" IsSelected="True"/>
            <ComboBoxItem Content="{DynamicResource Start.SortName}" Tag="Name"/>
          </ComboBox>
          <ToggleButton x:Name="DescendingButton" Content="&#xE74B;" Style="{StaticResource ToolToggle}" IsChecked="True"
                        Margin="6,0,0,0" ToolTip="{DynamicResource Start.SortDirection}" Click="Direction_Click"/>
        </StackPanel>
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <TextBox x:Name="SearchBox" FontSize="14" Height="30" Padding="9,4,33,4" TextChanged="Search_Changed"
                     BorderBrush="#C8C8C8" AutomationProperties.Name="{DynamicResource Start.Search}"/>
            <TextBlock x:Name="SearchHint" Text="{DynamicResource Start.Search}" FontSize="14" Foreground="#A4A4A4"
                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource GlyphFont}" FontSize="14" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" Foreground="#696969"/>
          </Grid>
          <Button Grid.Column="1" x:Name="FilterButton" Width="30" Height="30" Background="Transparent"
                  BorderThickness="0" Cursor="Hand" Click="Filter_Click"
                  ToolTip="Filtrar archivos recientes" AutomationProperties.Name="Filtrar archivos recientes">
            <TextBlock Text="&#xE71C;" FontFamily="{StaticResource GlyphFont}" FontSize="15" Foreground="#6D6D6D"/>
            <Button.ContextMenu>
              <ContextMenu x:Name="FilterMenu">
                <MenuItem Header="Todos los archivos" Tag="All" Click="FilterOption_Click" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Proyectos (.g3d)" Tag="G3D" Click="FilterOption_Click" IsCheckable="True"/>
                <MenuItem Header="Familias (.g3df)" Tag="G3DF" Click="FilterOption_Click" IsCheckable="True"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Grid>
      <Grid>
        <ListBox x:Name="Items" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource TileTemplate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Items_DoubleClick"
                 KeyDown="Items_KeyDown" PreviewMouseLeftButtonUp="Items_Click">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame" BorderBrush="Transparent" BorderThickness="2">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource RibbonHoverBorderBrush}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ContextMenu>
            <ContextMenu x:Name="ItemMenu" Opened="ItemMenu_Opened">
              <MenuItem x:Name="OpenItem" Header="{DynamicResource Start.OpenItem}" Click="OpenItem_Click"/>
              <MenuItem x:Name="ShowInFolderItem" Header="{DynamicResource Start.ShowInFolder}" Click="ShowInFolder_Click"/>
              <MenuItem x:Name="RemoveItem" Header="{DynamicResource Start.RemoveRecent}" Click="RemoveItem_Click"/>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="{DynamicResource Start.Empty}" FontSize="15" Foreground="#777777"
                   TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,10,0,0"
                   Visibility="Collapsed"/>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
