<UserControl x:Class="Guanacaste3D.Desktop.Controls.ArchitectureRibbon"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Height="104">
  <UserControl.Resources>
    <!-- The architecture tab reuses the shared ribbon metrics so every tab reads the same. -->
    <Style x:Key="ArchitectureCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactRibbonButtonStyle}"/>
    <Style x:Key="ArchitectureLargeButtonStyle" TargetType="Button" BasedOn="{StaticResource LargeRibbonButtonStyle}"/>
  </UserControl.Resources>
  <ScrollViewer x:Name="RibbonViewport" Style="{StaticResource RibbonScrollViewerStyle}"
                SizeChanged="RibbonViewport_SizeChanged"
                Background="{DynamicResource RibbonBrush}">
    <StackPanel x:Name="RibbonContent" Orientation="Horizontal" Margin="1,0,1,0">
      <StackPanel x:Name="GroupHost" Orientation="Horizontal"/>
      <Border x:Name="WallTypeGroup" Visibility="Collapsed" Style="{StaticResource RibbonGroupBorderStyle}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="17"/></Grid.RowDefinitions>
          <StackPanel Margin="5,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Tool.WallType}" Style="{StaticResource RibbonFieldLabelStyle}"/>
            <ComboBox x:Name="WallTypePicker" Width="188" Margin="0,3,0,4"/>
            <Button Content="{DynamicResource Properties.ApplyType}" Tag="ApplyWallType"
                    Click="ArchitectureButton_Click" Style="{StaticResource RibbonFieldButtonStyle}"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{DynamicResource RibbonGroup.Type}"
                     Style="{StaticResource RibbonGroupLabelStyle}"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
