<UserControl x:Class="Guanacaste3D.Desktop.Controls.ModelNavigationBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="36">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="1"/><Setter Property="Height" Value="29"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="18"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
   <Setter Property="Foreground" Value="#596572"/><Setter Property="Focusable" Value="False"/>
  </Style>
 </UserControl.Resources>
 <Border CornerRadius="4" BorderBrush="#AFB4B8" BorderThickness="1" Background="#F5F5F5" Padding="2">
  <StackPanel>
   <Button Content="&#xE711;" Tag="Close" Height="12" FontSize="8" HorizontalAlignment="Right" Width="12"
    ToolTip="{DynamicResource Navigation.HideBar}" Click="Action_Click"/>
   <Button x:Name="WheelButton" Tag="Wheel" Click="Action_Click"
    ToolTip="{DynamicResource Navigation.WheelHint}" AutomationProperties.Name="{DynamicResource Navigation.Wheel}"><Image Source="{StaticResource NavigationIcon.Wheel}" Width="24" Height="24"/></Button>
   <Button x:Name="WheelMenuButton" Content="&#xE70D;" FontSize="8" Height="12" Tag="WheelMenu" Click="Action_Click"
    ToolTip="{DynamicResource Navigation.WheelMenu}" AutomationProperties.Name="{DynamicResource Navigation.WheelMenu}"/>
   <Border Height="1" Margin="2,3" Background="#CCD0D3"/>
   <Button x:Name="ZoomButton" Tag="Region" Click="Action_Click"
    ToolTip="{DynamicResource Navigation.RegionHint}" AutomationProperties.Name="{DynamicResource Navigation.Region}"><Image Source="{StaticResource NavigationIcon.Region}" Width="23" Height="23"/></Button>
   <Button x:Name="ZoomMenuButton" Content="&#xE70D;" FontSize="8" Height="12" Tag="ZoomMenu" Click="Action_Click"
    ToolTip="{DynamicResource Navigation.ZoomMenu}" AutomationProperties.Name="{DynamicResource Navigation.ZoomMenu}"/>
  </StackPanel>
 </Border>
</UserControl>
