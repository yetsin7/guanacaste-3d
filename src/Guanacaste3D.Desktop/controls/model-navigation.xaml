<UserControl x:Class="Guanacaste3D.Desktop.Controls.ModelNavigation"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Guanacaste3D.Desktop.Controls" Width="156" Focusable="False">
 <UserControl.Resources>
  <Style x:Key="NavigationButton" TargetType="Button">
   <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
   <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#8E969C"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Focusable" Value="False"/>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <Grid Height="22" Margin="12,0">
   <Button Style="{StaticResource NavigationButton}" Content="&#xE80F;" Tag="Home" Click="Command_Click"
    HorizontalAlignment="Left" ToolTip="{DynamicResource Navigation.Home}" AutomationProperties.Name="{DynamicResource Navigation.Home}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{StaticResource NavigationButton}" Content="&#xE7A7;" Tag="Left" Click="Command_Click"
     ToolTip="{DynamicResource Navigation.Left}" AutomationProperties.Name="{DynamicResource Navigation.Left}"/>
    <Button Style="{StaticResource NavigationButton}" Content="&#xE7A6;" Tag="Right" Click="Command_Click"
     ToolTip="{DynamicResource Navigation.Right}" AutomationProperties.Name="{DynamicResource Navigation.Right}"/>
   </StackPanel>
  </Grid>
  <Canvas x:Name="CubeCanvas" Width="156" Height="136" Background="Transparent"
   MouseLeftButtonDown="Cube_MouseDown" MouseMove="Cube_MouseMove" MouseLeftButtonUp="Cube_MouseUp"
   LostMouseCapture="Cube_LostMouseCapture" ToolTip="{DynamicResource Navigation.CubeHint}"
   AutomationProperties.Name="{DynamicResource Navigation.CubeHint}"/>
  <controls:ModelNavigationBar x:Name="NavigationBar" HorizontalAlignment="Right" Margin="0,10,0,0"/>
 </StackPanel>
</UserControl>
