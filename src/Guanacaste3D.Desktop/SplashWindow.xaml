<Window x:Class="Guanacaste3D.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Name}" Icon="pack://application:,,,/Guanacaste3D.Desktop;component/resources/brand/guanacaste3d.ico"
        Width="460" Height="260" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <Border Margin="12" Padding="34,30" CornerRadius="18" Background="#FFFFFF"
          BorderBrush="#D8D8DD" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource Brand.Logo}" Width="72" Height="72"/>
        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource App.Name}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="{DynamicResource App.Tagline}" FontSize="13"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
      </StackPanel>
      <Grid Grid.Row="2" Margin="0,30,0,10" Height="4">
        <Border Background="#E5E5EA" CornerRadius="2"/>
        <Grid x:Name="ProgressTrack">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ProgressFilled" Width="0.01*"/>
            <ColumnDefinition x:Name="ProgressRemaining" Width="0.99*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"/>
        </Grid>
      </Grid>
      <Grid Grid.Row="3">
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Right"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </Grid>
    </Grid>
  </Border>
</Window>
